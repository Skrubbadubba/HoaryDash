{{define "modal"}}
{{if once "modal-style"}}
<style>
    .modal-container {
        display: -webkit-box;
        display: -webkit-flex;
        display: flex;
        pointer-events: none;
        opacity: 0;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 100;
        -webkit-box-align: center;
        -webkit-align-items: center;
        align-items: center;
        -webkit-box-pack: center;
        -webkit-justify-content: center;
        justify-content: center;
    }

    .modal-container.open {
        pointer-events: all;
        opacity: 1;
    }

    .modal-backdrop {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.65);
        z-index: 0;
    }

    .modal-modal {
        position: relative;
        z-index: 1;
        width: 75vw;
        height: 75vh;
        display: -webkit-box;
        display: -webkit-flex;
        display: flex;
        -webkit-box-orient: vertical;
        -webkit-flex-direction: column;
        flex-direction: column;
        overflow: hidden;
        transform: scale(0);
    }
    .modal-container.open .modal-modal {
        transform: scale(1);
    }

    .modal-header {
        display: -webkit-box;
        display: -webkit-flex;
        display: flex;
        -webkit-box-orient: horizontal;
        -webkit-flex-direction: row;
        flex-direction: row;
        -webkit-box-align: center;
        -webkit-align-items: center;
        align-items: center;
        padding: 0.6em 0.8em;
        -webkit-flex-shrink: 0;
        flex-shrink: 0;
        border-bottom: 0.05em solid rgba(255, 255, 255, 0.1);
    }

    .modal-list {
        -webkit-box-flex: 1;
        -webkit-flex: 1;
        flex: 1;
        overflow-y: auto;
        min-height: 0;
        padding: 0.4em 0;
    }

    .modal-row {
        display: -webkit-box;
        display: -webkit-flex;
        display: flex;
        -webkit-box-orient: horizontal;
        -webkit-flex-direction: row;
        flex-direction: row;
        -webkit-box-align: center;
        -webkit-align-items: center;
        align-items: center;
        padding: 0.45em 0.8em;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
        border-bottom: 0.04em solid rgba(255, 255, 255, 0.06);
    }

    .modal-row:active {
        background: rgba(255, 255, 255, 0.08);
    }

    .modal-empty {
        padding: 2em;
        text-align: center;
        opacity: 0.45;
        font-size: 0.75em;
        font-style: italic;
    }
</style>
{{end}}
<div class="modal-container transition-fast">
    <div class="modal-backdrop"></div>
    <div class="modal-modal modal border">
        <div class="modal-header on-surface">
        </div>
        <div class="modal-list"></div>
    </div>
</div>
<script>
component(function(modal) {
    var elList = modal.querySelector('.modal-list');

    modal.open = function() {
        modal.classList.add('open')
    }
    function close() {
        modal.classList.remove('open');
    }

    modal.querySelector('.modal-backdrop').onclick = close;
    modal.close = close;
    modal.renderList = function(items) {
        console.log("modal render list was called with: ", items)
        elList.innerHTML = '';

        if (!items || items.length === 0) {
            var empty = document.createElement('div');
            empty.className = 'modal-empty on-surface-muted';
            empty.textContent = 'Nothing here';
            elList.appendChild(empty);
            return;
        }

        for (var i = 0; i < items.length; i++) {
            var item = items[i];
            item.classList.add('modal-row', 'on-surface')
            elList.appendChild(item);
        }
    }
})
</script>
{{end}}