<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.Name}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap" rel="stylesheet">
    {{/* <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet"> */}}
    <script>
        (function(){
        var locale = '{{.Settings.Localization.Locale}}' || navigator.language || 'en-US';
        var timezone = '{{.Settings.Localization.Timezone}}' || Intl.DateTimeFormat().resolvedOptions().timeZone;
        window.ICON_MAP = {{.DomainClassStateIconMap}};
        window.CONFIG = {
            {{if .Settings.FullyKiosk}}
            fullyKiosk: {
                screensaverTimeout: {{.Settings.FullyKiosk.ScreensaverTimeout}}
            },
            {{end}}
            entity_ids: [
                {{/* Duplicates are fine so just loop over every possible entity definition */}}
                {{range .Dashboard.Screens}}
                    {{if .Sensors}}{{range .Sensors.Cards}}"{{.EntityID}}",{{end}}{{end}}
                    {{if .Entities}}{{range .Entities.Cards}}"{{.EntityID}}",{{end}}{{end}}
                    {{if .Widgets}}{{range .Widgets.Cards}}"{{.EntityID}}",{{end}}{{end}}
                    {{range .Groups}}{{range .Cards}} "{{.EntityID}}",{{end}}{{end}}
                    {{if .EntityID}}{{.EntityID}},{{end}}
                {{end}}
                ],
            locale: locale,
            timezone: timezone,
            {{/* haUrl: {{if .Config.HA.URL}}"{{.Config.HA.URL}}"{{else}}location.origin.replace(/:\d+$/, ':8123'){{end}}, */}}
            widgetPollInterval: 10 * 60 * 1000,
            };
        window.goFetch = function(path, callback) {
            var xhr = new XMLHttpRequest();
            xhr.open('GET', path, true);
            xhr.onreadystatechange = function() {
                if (xhr.readyState !== 4) { return; }
                if (xhr.status === 200) {
                    try { callback(null, JSON.parse(xhr.responseText)); }
                    catch(e) { callback(e, null); }
                } else {
                    callback(new Error('HTTP ' + xhr.status), null);
                }
            };
            xhr.send();
        };
        }());
    </script>
    {{template "websocket" .}}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/hammer.js/2.0.8/hammer.min.js"></script>
</head>
<body>
    {{if globals "IsDev"}}
        {{template "isdev"}}
    {{end}}
    {{$settings := .Settings}}
    {{template "base-style" .}}
    {{template "utility-styles"}}
    {{template "create-theme" (merge .Dashboard.Theme (dict "Prefix" "body"))}}
    <script>
        function component(script) {
            var root = document.currentScript.previousElementSibling;
            while (root.tagName === 'SCRIPT') {
                {{if globals "IsDev"}}
                console.log("component scripts previous sibling was a script, iterating back one node")
                {{end}}
                root = root.previousElementSibling
            }
            script(root);
        };
        function normalizeSize(container) {
            var divs = container.children;
            var tallest = 0;
            var widest = 0;
            for (var i = 0; i < divs.length; i++) {
                if (divs[i].tagName == "SCRIPT") { continue; }
                if (divs[i].offsetHeight > tallest) { tallest = divs[i].offsetHeight; }
                if (divs[i].offsetWidth > widest) { widest = divs[i].offsetWidth; }
            }
            for (var i = 0; i < divs.length; i++) {
                if (divs[i].tagName == "SCRIPT") { continue; }
                divs[i].style.height = tallest + 'px';
                divs[i].style.width = widest + 'px';
            }
        }
        function normalizeHeight(container) {
            var divs = container.children;
            var tallest = 0;
            for (var i = 0; i < divs.length; i++) {
                if (divs[i].tagName == "SCRIPT") { continue; }
                if (divs[i].offsetHeight > tallest) { tallest = divs[i].offsetHeight; }
            }
            for (var i = 0; i < divs.length; i++) {
                if (divs[i].tagName == "SCRIPT") { continue; }
                divs[i].style.height = tallest + 'px';
            }
        }
        function normalizeWidth(container) {
            var divs = container.children;
            var widest = 0;
            for (var i = 0; i < divs.length; i++) {
                if (divs[i].tagName == "SCRIPT") { continue; }
                if (divs[i].offsetWidth > widest) { widest = divs[i].offsetWidth; }
            }
            for (var i = 0; i < divs.length; i++) {
                if (divs[i].tagName == "SCRIPT") { continue; }
                divs[i].style.width = widest + 'px';
            }
        }
    </script>
    <style>
        .screens {
            overflow-x: hidden;
            overflow-y: hidden;
            -webkit-overflow-scrolling: touch;
            touch-action: pan-y;
            {{if enabledByDefault .Dashboard.Animations}}
            scroll-behavior: smooth;
            {{end}}
        }

        .screens::-webkit-scrollbar {
            display: none;
        }

        .screen {
            position: relative;
             overflow: hidden;
            touch-action: pan-y;
            -webkit-transition: -webkit-transform 0.5s ease;
            transition: transform 0.5s ease;
        }

        .layout-container {
            overflow-x: hidden;
        }
            
        {{$showHints := enabledByDefault .Dashboard.ShowHints}}
        .layout-padding {
            padding:{{if $showHints}}1em 3.5em;{{else}}1em;{{end}}
        }

        {{if .Dashboard.Navbar.Enabled}}
        {{$position := .Dashboard.Navbar.Position | default "bottom"}}
        {{$navbarStylePad := 0.0}}
        {{if eq .Dashboard.Navbar.Style "rectangle"}}
            {{$navbarStylePad = 1.5}}
        {{end}}

         .navbar-padding {
            {{if eq $position "bottom"}}padding-bottom: {{add 5.0 $navbarStylePad}}em;{{end}}
            {{if eq $position "top"}}padding-top: {{add 5.0 $navbarStylePad}}em;{{end}}
            {{if eq $position "left"}}padding-left: {{add 5.5 $navbarStylePad}}em;{{end}}
            {{if eq $position "right"}}padding-right: {{add 5.5 $navbarStylePad}}em;{{end}}
        }

        {{end}}

        {{if $showHints}}
        .swipe-hint {
            position: absolute;
            top: 50%;
            -webkit-transform: translateY(-50%);
            transform: translateY(-50%);
            opacity: 0.2;
        }

        .swipe-hint.left {
            left: 0.1em;
        }

        .swipe-hint.right {
            right: 0.11em;
        }
        {{end}}
    </style>
    <div class="screens flex flex-row size-full">
    
    {{range $i, $screen := .Dashboard.Screens}}
        {{$id := ""}}
        {{if .Name}}
            {{$id = concat "screen-" .Name}}
        {{else}}
            {{$id = concat "screen-" $i}}
        {{end}}
        {{if $screen.Theme}}
            {{template "create-theme" (merge $screen.Theme (dict "Prefix" (concat "#" $id)))}}
        {{end}}
        <div id="{{$id}}" class="screen flex-shrink-0 size-full">
            {{if $showHints}}
            {{with prevScreen $.Dashboard $i}}
                <div class="swipe-hint left on-bg flex-line font-lg">
                    {{icon "chevron-left"}}
                    {{if .Icon}}{{icon .Icon}}{{end}}
                </div>
            {{end}}
            {{end}}
            {{/* <p>{{json .}}</p> */}}
            {{if isFull $screen.Layout}}
                <div class="layout-container size-full">
            {{else}}
                <div class="layout-container layout-padding navbar-padding size-full">
            {{end}}
            {{if eq $screen.Layout "tiled"}}
                {{template "tiled-layout" $screen}}
                {{else if eq $screen.Layout "media-full"}}
                    {{template "fullscreen-media-layout" $screen}}
                {{else}}
                    {{template "centered-layout" $screen}}
                {{end}}
            </div>
            {{if $showHints}}
            {{with nextScreen $.Dashboard $i}}
            <div class="swipe-hint right on-bg flex-line font-lg">
                {{if .Icon}}{{icon .Icon}}{{end}}
                {{icon "chevron-right"}}
            </div>
            {{end}}
        {{end}}
        </div>
    {{end}}
    </div>
    <script>
    component(function(container) {
        var screens = container.querySelectorAll('.screen');
        var currentIndex = 0;
        var xOffset = 0;

        for (var i = 0; i < screens.length; i++) {
            if (screens[i].id == window.location.hash.replace("#", "")) {
                currentIndex = i;
                break;
            }
        }
        xOffset = currentIndex;

        function dispatchNavigate() {
            window.dispatchEvent(new CustomEvent("screen-navigate", { detail: { index: currentIndex } }));
        }

        window.addEventListener("DOMContentLoaded", dispatchNavigate)

        {{/* dispatchNavigate(); */}}
        window.navigateTo = function(index) {
            if (index < 0 || index >= screens.length) { return; }
            currentIndex = index;
            screenEl = screens[currentIndex];

            // Avoid automatic scroll by using history API instead of location.hash
            history.pushState({}, '', "#" + screenEl.id);
            for (var i = 0; i < screens.length; i++) {
                screens[i].style.transform = "translateX(" + (xOffset - index)*100 + "%)";
            }
            dispatchNavigate();
        };

        function realign() {
            // Use native scroll to realign by changing hash
            location.hash = screens[currentIndex].id
        }

        window.addEventListener("resize", realign)


        {{if enabledByDefault .Dashboard.Swipe}}
        var mc = new Hammer.Manager(document.body);
        mc.add(new Hammer.Swipe({
            direction: Hammer.DIRECTION_HORIZONTAL,
            threshold: 10,
            velocity: 0.3
        }));
        {{/* mc.set({ inputClass: Hammer.MouseInput }); */}}
        mc.on('swipeleft swiperight', function(e) {
            if (e.type === 'swipeleft') {
                window.navigateTo(currentIndex + 1);
            } else if (e.type === 'swiperight') {
                window.navigateTo(currentIndex - 1);
            }
        });
        {{end}}
    });
    </script>


    {{if enabledByDefault .Dashboard.Screenonlock}}
        {{template "screenonlock"}}
    {{end}}
    {{if or (enabledByDefault .Dashboard.Screenonlock) (enabledByDefault .Dashboard.Nightlight.Enabled)}}
        {{if $settings.FullyKiosk}}
            {{template "screenonlock-script-fully" $settings.FullyKiosk}}
        {{else if disabledByDefault $settings.WallPanel}}
            {{template "screenonlock-script-wallpanel" $settings.WallPanel}}
        {{end}}
    {{end}}
    {{/* <p>{{json .Dashboard.Nightlight}}</p> */}}
    {{if enabledByDefault .Dashboard.Nightlight.Enabled}}
        {{template "nightlight" .}}
    {{end}}

    {{if .Dashboard.Navbar.Enabled}}
        {{$orientation := "horizontal"}}
        {{if or (eq .Dashboard.Navbar.Position "left") (eq .Dashboard.Navbar.Position "right")}}
            {{$orientation = "vertical"}}
        {{end}}

        <style>
            .navbar-container {
                position: absolute;
                z-index: 5;
            }
            .navbar-container.navbar-bottom {
                bottom: 1em;
                left: 50%;
                -webkit-transform: translateX(-50%);
                transform: translateX(-50%);
            }
            .navbar-container.navbar-top {
                top: 1em;
                left: 50%;
                -webkit-transform: translateX(-50%);
                transform: translateX(-50%);
            }
            .navbar-container.navbar-left {
                left: 1em;
                top: 50%;
                -webkit-transform: translateY(-50%);
                transform: translateY(-50%);
            }
            .navbar-container.navbar-right {
                right: 1em;
                top: 50%;
                -webkit-transform: translateY(-50%);
                transform: translateY(-50%);
            }
            .navbar-container.navbar-horizontal > nav {
                {{template "_flex-row"}}
            }
            .navbar-container.navbar-vertical > nav {
                 {{template "_flex-col"}}
            }
        </style>
        <div class="navbar-container navbar-{{.Dashboard.Navbar.Position | default "bottom"}} navbar-{{$orientation}}">
            {{template "navbar" .Dashboard.Screens}}
            {{if eq .Dashboard.Navbar.Style "rectangle"}}
                {{template "navbar-rectangle-style" .Dashboard.Navbar}}
            {{else}}
                {{template "navbar-default-style" .Dashboard.Theme}}
            {{end}}
        </div>
    {{end}}
 
    <script>
        // Connect to HA as late as possible to make sure all
        // scripts have been parsed before connection is opened
        window.connectToHa();
    </script>
</body>
</html>