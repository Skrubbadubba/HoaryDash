{{define "media-browser"}}
{{if once "media-browser-style"}}
<style>
    .mbrowser-back {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 1.4em;
        line-height: 1;
        padding: 0.1em 0.4em 0.1em 0;
        opacity: 0.75;
        -webkit-tap-highlight-color: transparent;
        color: inherit;
        -webkit-flex-shrink: 0;
        flex-shrink: 0;
    }

    .mbrowser-back:active {
        opacity: 0.4;
    }

    .mbrowser-back[disabled] {
        opacity: 0.2;
        cursor: default;
    }

    .mbrowser-breadcrumbs {
        -webkit-box-flex: 1;
        -webkit-flex: 1;
        flex: 1;
        display: -webkit-box;
        display: -webkit-flex;
        display: flex;
        -webkit-box-orient: horizontal;
        -webkit-flex-direction: row;
        flex-direction: row;
        -webkit-box-align: center;
        -webkit-align-items: center;
        align-items: center;
        overflow: hidden;
        font-size: 0.8em;
    }

    .mbrowser-crumb {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        opacity: 0.55;
        -webkit-flex-shrink: 1;
        flex-shrink: 1;
        min-width: 0;
    }

    .mbrowser-crumb.active {
        opacity: 1;
        font-weight: 600;
        -webkit-flex-shrink: 0;
        flex-shrink: 0;
    }

    .mbrowser-crumb-sep {
        padding: 0 0.35em;
        opacity: 0.3;
        -webkit-flex-shrink: 0;
        flex-shrink: 0;
    }

    .mbrowser-row-thumb {
        width: 2.6em;
        height: 2.6em;
        -webkit-flex-shrink: 0;
        flex-shrink: 0;
        border-radius: 0.2em;
        overflow: hidden;
        margin-right: 0.7em;
        display: -webkit-box;
        display: -webkit-flex;
        display: flex;
        -webkit-box-align: center;
        -webkit-align-items: center;
        align-items: center;
        -webkit-box-pack: center;
        -webkit-justify-content: center;
        justify-content: center;
        font-size: 1.2em;
    }

    .mbrowser-row-thumb svg {
        width: 1.4em;
        height: 1.4em;
        fill: currentColor;
        opacity: 0.7;
    }

    .mbrowser-row-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .mbrowser-row-title {
        -webkit-box-flex: 1;
        -webkit-flex: 1;
        flex: 1;
        min-width: 0;
        font-size: 0.75em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .mbrowser-row button {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 1.5em;
        line-height: 1;
        padding: 0.2em 0.3em;
        opacity: 0.7;
        -webkit-tap-highlight-color: transparent;
        -webkit-flex-shrink: 0;
        flex-shrink: 0;
        color: inherit;
        margin-left: 0.5em;
    }

    .mbrowser-row-play:active {
        opacity: 0.35;
    }

    .mbrowser-empty {
        padding: 2em;
        text-align: center;
        opacity: 0.45;
        font-size: 0.75em;
        font-style: italic;
    }
</style>
{{end}}
{{template "media-controller" .}}
{{template "modal"}}

<script>
component(function(modal) {
    var entityId = {{.EntityID}};
    if (!entityId) { return; }

    var elBackdrop  = modal.querySelector('.modal-backdrop');
    var elList      = modal.querySelector('.modal-list');
    {{if globals "IsDev"}}
    console.log("media browser root is: ", modal);
    {{end}}
    modal.querySelector('.modal-header').innerHTML = 
              '<button class="mbrowser-back on-surface" disabled>{{icon "chevron-left"}}</button>'
            + '<div class="mbrowser-breadcrumbs"></div>'

    var elBack      = modal.querySelector('.mbrowser-back');
    var elCrumbs    = modal.querySelector('.mbrowser-breadcrumbs');
    
    var ctrl = makeMediaController(entityId{{if .Spotifyplus}}, { spotifyPlus: true }{{end}});

    /*
     * Stack entries: { title, id, type }
     * id/type are null for the root level.
     * Pushing on navigate-in, popping on back.
     * Re-fetching is always done from the entry now on top after a pop.
     */
    var stack = [];

     var ICON_MAP = [
        { substring: 'playlist',  svg: '{{icon "playlist-music"}}' },
        { substring: 'artist',    svg: '{{icon "account-music"}}' },
        { substring: 'album',     svg: '{{icon "album"}}' },
        { substring: 'track',     svg: '{{icon "music-note"}}' },
        { substring: 'music',     svg: '{{icon "music"}}' },
        { substring: 'podcast',   svg: '{{icon "podcast"}}' },
        { substring: 'episode',   svg: '{{icon "podcast"}}' },
        { substring: 'channel',   svg: '{{icon "television-play"}}' },
        { substring: 'movie',     svg: '{{icon "movie"}}' },
        { substring: 'tvshow',    svg: '{{icon "television-classic"}}' },
        { substring: 'season',    svg: '{{icon "television-classic"}}' },
        { substring: 'image',     svg: '{{icon "image"}}' },
        { substring: 'url',       svg: '{{icon "link"}}' },
        { substring: 'genre',     svg: '{{icon "music-clef-treble"}}' },
        { substring: 'composer',  svg: '{{icon "music-clef-treble"}}' },
        { substring: 'directory', svg: '{{icon "folder"}}' }
    ];

    var ICON_FALLBACK = '{{icon "music"}}';

    function classIcon(mediaContentType) {
        var t = (mediaContentType || '').toLowerCase();
        for (var i = 0; i < ICON_MAP.length; i++) {
            if (t.indexOf(ICON_MAP[i].substring) !== -1) {
                return ICON_MAP[i].svg;
            }
        }
        return ICON_FALLBACK;
    }

    function renderCrumbs() {
        elCrumbs.innerHTML = '';
        for (var i = 0; i < stack.length; i++) {
            if (i > 0) {
                var sep = document.createElement('span');
                sep.className = 'mbrowser-crumb-sep on-surface-muted';
                sep.textContent = '›';
                elCrumbs.appendChild(sep);
            }
            var crumb = document.createElement('span');
            crumb.className = 'mbrowser-crumb' +
                (i === stack.length - 1 ? ' active on-surface' : ' on-surface-muted');
            crumb.textContent = stack[i].title;
            elCrumbs.appendChild(crumb);
        }
        elList.scrollTop = 0;
    }

    function renderList(children) {
        var rows = [];

        for (var i = 0; i < children.length; i++) {
            (function(item) {
                var row = document.createElement('div');
                row.className = 'mbrowser-row';

                var thumb = document.createElement('div');
                thumb.className = 'mbrowser-row-thumb surface-subtle accent-muted';
                if (item.thumbnail) {
                    var img = document.createElement('img');
                    img.setAttribute('alt', '');
                    img.setAttribute('src', item.thumbnail);
                    thumb.appendChild(img);
                } else {
                    thumb.innerHTML = classIcon(item.media_content_type);
                }

                var title = document.createElement('span');
                title.className = 'mbrowser-row-title';
                title.textContent = item.title || '—';

                row.appendChild(thumb);
                row.appendChild(title);

                if (item.can_play) {
                    {{if .Queue}}
                        var queueBtn = document.createElement('button');
                        queueBtn.className = 'mbrowser-row-queue';
                        queueBtn.innerHTML = '{{icon "playlist-plus"}}';
                        queueBtn.title = 'queue';
                        queueBtn.onclick = function(e) {
                            e.stopPropagation();
                            ctrl.queueItem(item);
                            modal.close();
                        };
                        row.appendChild(queueBtn);
                    {{end}}
                    var playBtn = document.createElement('button');
                    playBtn.className = 'mbrowser-row-play';
                    playBtn.innerHTML = '{{icon "play-circle"}}';
                    playBtn.title = 'Play';
                    playBtn.onclick = function(e) {
                        e.stopPropagation();
                        ctrl.playItem(item, stack);
                        modal.close();
                    };
                    row.appendChild(playBtn);
                    
                }

                if (item.can_expand) {
                    row.onclick = function() { navigateTo(item); };
                } else if (item.can_play) {
                    row.onclick = function() { ctrl.playItem(item, stack); modal.close(); };
                } else {
                    row.style.cursor = 'default';
                    row.style.opacity = '0.45';
                }
                rows.push(row);
            })(children[i]);
        }
        modal.renderList(rows);
    }

    

    function navigateTo(item) {
        elList.innerHTML = '';
        ctrl.browse(item.media_content_id, item.media_content_type)
            .then(function(data) {
                stack.push({
                    title: (data && data.title) ? data.title : (item.title || 'Media'),
                    id:    item.media_content_id,
                    type:  item.media_content_type,
                    canPlay: item.can_play,
                });
                elBack.disabled = false;
                renderCrumbs();
                renderList(data ? data.children : []);
            })
            .catch(function(err) {
                console.error('media browse failed:', err);
                renderList([]);
            });
    }

    function goBack() {
        if (stack.length <= 1) { return; }
        stack.pop();
        var parent = stack[stack.length - 1];
        elList.innerHTML = '';
        ctrl.browse(parent.id, parent.type)
            .then(function(data) {
                elBack.disabled = stack.length <= 1;
                renderCrumbs();
                renderList(data ? data.children : []);
            })
            .catch(function(err) {
                console.error('media browse back failed:', err);
            });
    }

    function open() {
        stack = [];
        elBack.disabled = true;
        elCrumbs.innerHTML = '';
        elList.innerHTML = '';
        modal.open();
        ctrl.browse(null, null)
            .then(function(data) {
                stack.push({
                    title: (data && data.title) ? data.title : 'Media',
                    id:    null,
                    type:  null,
                    canPlay: null,
                });
                renderCrumbs();
                renderList(data ? data.children : []);
            })
            .catch(function(err) {
                console.error('media browse open failed:', err);
                renderList([]);
            });
    }
    elBack.onclick = goBack;

    document.addEventListener('keydown', function(e) {
        if (e.keyCode === 27 && modal.className.indexOf('open') !== -1) {
            modal.close();
        }
    });

    // caller does modal.mediaBrowserOpen()
    modal.mediaBrowserOpen = open;
});
</script>
{{end}}
