{{define "media-browser"}}
{{if once "media-browser-style"}}
<style>
    .mbrowser-container {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 100;
        -webkit-box-align: center;
        -webkit-align-items: center;
        align-items: center;
        -webkit-box-pack: center;
        -webkit-justify-content: center;
        justify-content: center;
    }

    .mbrowser-container.open {
        display: -webkit-box;
        display: -webkit-flex;
        display: flex;
    }

    .mbrowser-backdrop {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.65);
        z-index: 0;
    }

    .mbrowser-modal {
        position: relative;
        z-index: 1;
        width: 75vw;
        height: 75vh;
        display: -webkit-box;
        display: -webkit-flex;
        display: flex;
        -webkit-box-orient: vertical;
        -webkit-flex-direction: column;
        flex-direction: column;
        overflow: hidden;
    }

    .mbrowser-header {
        display: -webkit-box;
        display: -webkit-flex;
        display: flex;
        -webkit-box-orient: horizontal;
        -webkit-flex-direction: row;
        flex-direction: row;
        -webkit-box-align: center;
        -webkit-align-items: center;
        align-items: center;
        padding: 0.6em 0.8em;
        -webkit-flex-shrink: 0;
        flex-shrink: 0;
        border-bottom: 0.05em solid rgba(255, 255, 255, 0.1);
    }

    .mbrowser-back {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 1.4em;
        line-height: 1;
        padding: 0.1em 0.4em 0.1em 0;
        opacity: 0.75;
        -webkit-tap-highlight-color: transparent;
        color: inherit;
        -webkit-flex-shrink: 0;
        flex-shrink: 0;
    }

    .mbrowser-back:active {
        opacity: 0.4;
    }

    .mbrowser-back[disabled] {
        opacity: 0.2;
        cursor: default;
    }

    .mbrowser-breadcrumbs {
        -webkit-box-flex: 1;
        -webkit-flex: 1;
        flex: 1;
        display: -webkit-box;
        display: -webkit-flex;
        display: flex;
        -webkit-box-orient: horizontal;
        -webkit-flex-direction: row;
        flex-direction: row;
        -webkit-box-align: center;
        -webkit-align-items: center;
        align-items: center;
        overflow: hidden;
        font-size: 0.8em;
    }

    .mbrowser-crumb {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        opacity: 0.55;
        -webkit-flex-shrink: 1;
        flex-shrink: 1;
        min-width: 0;
    }

    .mbrowser-crumb.active {
        opacity: 1;
        font-weight: 600;
        -webkit-flex-shrink: 0;
        flex-shrink: 0;
    }

    .mbrowser-crumb-sep {
        padding: 0 0.35em;
        opacity: 0.3;
        -webkit-flex-shrink: 0;
        flex-shrink: 0;
    }

    .mbrowser-list {
        -webkit-box-flex: 1;
        -webkit-flex: 1;
        flex: 1;
        overflow-y: auto;
        min-height: 0;
        padding: 0.4em 0;
    }

    .mbrowser-row {
        display: -webkit-box;
        display: -webkit-flex;
        display: flex;
        -webkit-box-orient: horizontal;
        -webkit-flex-direction: row;
        flex-direction: row;
        -webkit-box-align: center;
        -webkit-align-items: center;
        align-items: center;
        padding: 0.45em 0.8em;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
        border-bottom: 0.04em solid rgba(255, 255, 255, 0.06);
    }

    .mbrowser-row:active {
        background: rgba(255, 255, 255, 0.08);
    }

    .mbrowser-row-thumb {
        width: 2.6em;
        height: 2.6em;
        -webkit-flex-shrink: 0;
        flex-shrink: 0;
        border-radius: 0.2em;
        background: rgba(255, 255, 255, 0.08);
        overflow: hidden;
        margin-right: 0.7em;
        display: -webkit-box;
        display: -webkit-flex;
        display: flex;
        -webkit-box-align: center;
        -webkit-align-items: center;
        align-items: center;
        -webkit-box-pack: center;
        -webkit-justify-content: center;
        justify-content: center;
        font-size: 1.2em;
    }

    .mbrowser-row-thumb svg {
        width: 1.4em;
        height: 1.4em;
        fill: currentColor;
        opacity: 0.7;
    }

    .mbrowser-row-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .mbrowser-row-title {
        -webkit-box-flex: 1;
        -webkit-flex: 1;
        flex: 1;
        min-width: 0;
        font-size: 0.75em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .mbrowser-row-play {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 1.5em;
        line-height: 1;
        padding: 0.2em 0.3em;
        opacity: 0.7;
        -webkit-tap-highlight-color: transparent;
        -webkit-flex-shrink: 0;
        flex-shrink: 0;
        color: inherit;
        margin-left: 0.5em;
    }

    .mbrowser-row-play:active {
        opacity: 0.35;
    }

    .mbrowser-empty {
        padding: 2em;
        text-align: center;
        opacity: 0.45;
        font-size: 0.75em;
        font-style: italic;
    }
</style>
{{end}}

<div class="mbrowser-container">
    <div class="mbrowser-backdrop"></div>
    <div class="mbrowser-modal card opaque">
        <div class="mbrowser-header">
            <button class="mbrowser-back font-primary" disabled>{{icon "chevron-left"}}</button>
            <div class="mbrowser-breadcrumbs"></div>
        </div>
        <div class="mbrowser-list"></div>
    </div>
</div>

<script>
component(function(wrapper) {
    var entityId = {{.EntityID}};
    if (!entityId) { return; }

    var elBackdrop  = wrapper.querySelector('.mbrowser-backdrop');
    var elBack      = wrapper.querySelector('.mbrowser-back');
    var elCrumbs    = wrapper.querySelector('.mbrowser-breadcrumbs');
    var elList      = wrapper.querySelector('.mbrowser-list');

    /*
     * Stack entries: { title, id, type }
     * id/type are null for the root level.
     * Pushing on navigate-in, popping on back.
     * Re-fetching is always done from the entry now on top after a pop.
     */
    var stack = [];

     var ICON_MAP = [
        { substring: 'playlist',  svg: '{{icon "playlist-music"}}' },
        { substring: 'artist',    svg: '{{icon "account-music"}}' },
        { substring: 'album',     svg: '{{icon "album"}}' },
        { substring: 'track',     svg: '{{icon "music-note"}}' },
        { substring: 'music',     svg: '{{icon "music"}}' },
        { substring: 'podcast',   svg: '{{icon "podcast"}}' },
        { substring: 'episode',   svg: '{{icon "podcast"}}' },
        { substring: 'channel',   svg: '{{icon "television-play"}}' },
        { substring: 'movie',     svg: '{{icon "movie"}}' },
        { substring: 'tvshow',    svg: '{{icon "television-classic"}}' },
        { substring: 'season',    svg: '{{icon "television-classic"}}' },
        { substring: 'image',     svg: '{{icon "image"}}' },
        { substring: 'url',       svg: '{{icon "link"}}' },
        { substring: 'genre',     svg: '{{icon "music-clef-treble"}}' },
        { substring: 'composer',  svg: '{{icon "music-clef-treble"}}' },
        { substring: 'directory', svg: '{{icon "folder"}}' }
    ];

    var ICON_FALLBACK = '{{icon "music"}}';

    function classIcon(mediaContentType) {
        var t = (mediaContentType || '').toLowerCase();
        for (var i = 0; i < ICON_MAP.length; i++) {
            if (t.indexOf(ICON_MAP[i].substring) !== -1) {
                return ICON_MAP[i].svg;
            }
        }
        return ICON_FALLBACK;
    }

    function renderCrumbs() {
        elCrumbs.innerHTML = '';
        for (var i = 0; i < stack.length; i++) {
            if (i > 0) {
                var sep = document.createElement('span');
                sep.className = 'mbrowser-crumb-sep font-secondary';
                sep.textContent = '›';
                elCrumbs.appendChild(sep);
            }
            var crumb = document.createElement('span');
            crumb.className = 'mbrowser-crumb' +
                (i === stack.length - 1 ? ' active font-primary' : ' font-secondary');
            crumb.textContent = stack[i].title;
            elCrumbs.appendChild(crumb);
        }
        elList.scrollTop = 0;
    }

    function renderList(children) {
        elList.innerHTML = '';

        if (!children || children.length === 0) {
            var empty = document.createElement('div');
            empty.className = 'mbrowser-empty font-secondary';
            empty.textContent = 'Nothing here';
            elList.appendChild(empty);
            return;
        }

        for (var i = 0; i < children.length; i++) {
            (function(item) {
                var row = document.createElement('div');
                row.className = 'mbrowser-row';

                var thumb = document.createElement('div');
                thumb.className = 'mbrowser-row-thumb';
                if (item.thumbnail) {
                    var img = document.createElement('img');
                    img.setAttribute('alt', '');
                    img.setAttribute('src', item.thumbnail);
                    thumb.appendChild(img);
                } else {
                    thumb.innerHTML = classIcon(item.media_content_type);
                }

                var title = document.createElement('span');
                title.className = 'mbrowser-row-title font-primary';
                title.textContent = item.title || '—';

                row.appendChild(thumb);
                row.appendChild(title);

                if (item.can_play) {
                    var playBtn = document.createElement('button');
                    playBtn.className = 'mbrowser-row-play font-primary';
                    playBtn.innerHTML = '{{icon "play-circle"}}';
                    playBtn.title = 'Play';
                    playBtn.onclick = function(e) {
                        e.stopPropagation();
                        playItem(item);
                    };
                    row.appendChild(playBtn);
                }

                if (item.can_expand) {
                    row.onclick = function() { navigateTo(item); };
                } else if (item.can_play) {
                    row.onclick = function() { playItem(item); };
                } else {
                    row.style.cursor = 'default';
                    row.style.opacity = '0.45';
                }

                elList.appendChild(row);
            })(children[i]);
        }
    }

    function fetchLevel(id, type) {
        var msg = {
            type: 'call_service',
            domain: 'media_player',
            service: 'browse_media',
            target: { entity_id: entityId },
            return_response: true
        };
        if (id !== null && id !== undefined) {
            msg.service_data = {
                media_content_id: id,
                media_content_type: type
            };
        }
        return window.haSend(msg).then(function(result) {
            console.log("called browser media, got: ", result)
            return result && result["response"] && result["response"][entityId] ? result["response"][entityId] : result;
        });
    }

    function navigateTo(item) {
        elList.innerHTML = '';
        fetchLevel(item.media_content_id, item.media_content_type)
            .then(function(data) {
                stack.push({
                    title: (data && data.title) ? data.title : (item.title || 'Media'),
                    id:    item.media_content_id,
                    type:  item.media_content_type
                });
                elBack.disabled = false;
                renderCrumbs();
                renderList(data ? data.children : []);
            })
            .catch(function(err) {
                console.error('media browse failed:', err);
                renderList([]);
            });
    }

    function goBack() {
        if (stack.length <= 1) { return; }
        stack.pop();
        var parent = stack[stack.length - 1];
        elList.innerHTML = '';
        fetchLevel(parent.id, parent.type)
            .then(function(data) {
                elBack.disabled = stack.length <= 1;
                renderCrumbs();
                renderList(data ? data.children : []);
            })
            .catch(function(err) {
                console.error('media browse back failed:', err);
            });
    }

    function playItem(item) {
        window.haSend({
            type: 'call_service',
            domain: 'media_player',
            service: 'play_media',
            target: { entity_id: entityId },
            service_data: {
                media_content_id: item.media_content_id,
                media_content_type: item.media_content_type
            }
        }).catch(function(err) {
            console.error('media play failed:', err);
        });
        close();
    }

    function open() {
        stack = [];
        elBack.disabled = true;
        elCrumbs.innerHTML = '';
        elList.innerHTML = '';
        wrapper.className = 'mbrowser-container open';
        fetchLevel(null, null)
            .then(function(data) {
                stack.push({
                    title: (data && data.title) ? data.title : 'Media',
                    id:    null,
                    type:  null
                });
                renderCrumbs();
                renderList(data ? data.children : []);
            })
            .catch(function(err) {
                console.error('media browse open failed:', err);
                renderList([]);
            });
    }

    function close() {
        wrapper.className = 'mbrowser-container';
    }

    elBackdrop.onclick = close;
    elBack.onclick = goBack;

    document.addEventListener('keydown', function(e) {
        if (e.keyCode === 27 && wrapper.className.indexOf('open') !== -1) {
            close();
        }
    });

    // caller does wrapper.mediaBrowserOpen()
    wrapper.mediaBrowserOpen = open;
});
</script>
{{end}}
