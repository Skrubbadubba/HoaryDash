{{define "media-widget" }}
{{if once "media-widget-style"}}
<style>
    .media-container {
        overflow: hidden;
        font-family: inherit;
    }

    .media-top-row {
        position: relative;
    }

    .media-info {
        min-width: 0;
    }

    .media-cover {
        width: 3em;
        height: 3em;
        -webkit-flex-shrink: 0;
        flex-shrink: 0;
        background: rgba(255, 255, 255, 0.08);
        overflow: hidden;
        margin-right: 0.6em;
    }

    .media-cover img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .media-song-info {
        min-width: 0;
    }

    .media-song {
        font-weight: 600;
        color: #e0f0ff;
        display: block;
    }

    .media-artist {
        color: #8899aa;
        display: block;
        margin-top: 0.15em;
    }

    .media-album {
        color: #8899aa;
        display: block;
        margin-top: 0.1em;
        opacity: 0.7;
    }

    .media-idle {
        color: #8899aa;
        font-style: italic;
    }


    .media-ctrl-btn {
        background: none;
        border: none;
        cursor: pointer;
        line-height: 1;
        line-height: 1;
        opacity: 0.85;
        color: #c0d8f0;
    }

    .media-ctrl-btn:active {
        opacity: 0.5;
    }

    .media-ctrl-btn.play {
        opacity: 1;
    }


    .media-vol-icon {
        padding: 0 0.3em;
        height: 1em;
    }

    .media-vol-slider {
        height: 0.6em;
        border-radius: 0.2em;
        background: rgba(255, 255, 255, 0.15);
        outline: none;
        cursor: pointer;
    }

    {{$thumbStyle := "width: 1.8em; height: 1.8em; background: #949494;" | css}}
    .media-vol-slider::-webkit-slider-thumb { {{$thumbStyle}} }
    .media-vol-slider::-moz-range-thumb { {{$thumbStyle}} }

    .media-browser-button {
        background: none;
        border: none;
    }
</style>
{{end}}
{{template "media-controller"}}
{{with .Options}}
<div class="media-container widget card border card-wrapper">
    <div class="media-top-row padding widget card card-inner flex flex-row align-start">
        <div class="media-info flex-line flex-grow">
            <div class="media-cover border-tight">
                <div class="media-cover-placeholder accent flex size-full justify-center align-center font-lg">{{icon "music"}}</div>
            </div>
            <div class="media-song-info flex flex-col align-start justify-center text-ellipsis">
                <span class="media-idle on-surface-subtle">Idle</span>
            </div>
        </div>
        {{if .ShowBrowser}}
        <div class="media-browse flex-shrink-0">
            <button class="media-browser-button on-surface-muted font-lg">{{icon "play-box-multiple"}}</button>
        </div>
        {{end}}
    </div>
    {{if enabledByDefault .InternalBorders}}
        <div class="divider-horizontal divider-thin border-bg flex-shrink-0"></div>
    {{end}}
    <div class="media-bottom-row widget card card-inner gap-x gap-outer flex-line justify-between">
        {{if enabledByDefault .ShowVolume }}
        <div class="media-vol-controls flex-line">
            <span class="media-vol-icon accent-muted font-lg">{{icon "volume-high"}}</span>
            <input class="media-vol-slider interactive-muted-bg interactive-thumb thumb flex-grow" type="range" min="0" max="1" step="0.02" value="0.5" />
        </div>
        {{ end }}
        <div class="media-play-controls font-lg gap-inner gap-x flex-line flex-shrink-0">
            <button class="media-ctrl-btn btn shuffle on-surface-subtle hide" title="shuffle">{{icon "shuffle"}}</button>
            <button class="media-ctrl-btn btn back on-surface-muted" title="Previous">{{icon "skip-backward"}}</button>
            <button class="media-ctrl-btn btn font-xl play on-surface" title="Play-Pause">{{icon "play"}}</button>
            <button class="media-ctrl-btn btn forward on-surface-muted" title="Next">{{icon "skip-forward"}}</button>
            <button class="media-ctrl-btn btn repeat on-surface-subtle hide" title="repeat">{{icon "repeat"}}</button>
        </div>

    </div>
    {{if .ShowBrowser}}
    {{template "media-browser" .}}
    {{end}}
</div>
{{end}}
<script>
component(function(wrapper) {
    var entityId = {{.EntityID}}
    if (!entityId) { return; }

    var elIdle = wrapper.querySelector('.media-idle');
    var elSongInfo = wrapper.querySelector('.media-song-info');
    var elCover = wrapper.querySelector('.media-cover');
    var elPlaceholder = wrapper.querySelector('.media-cover-placeholder');
    var elVol = wrapper.querySelector('.media-vol-icon');
    var elPlay = wrapper.querySelector('.media-ctrl-btn.play');
    var elBack = wrapper.querySelector('.media-ctrl-btn.back');
    var elForward = wrapper.querySelector('.media-ctrl-btn.forward');
    var elShuffle = wrapper.querySelector('.media-ctrl-btn.shuffle');
    var elRepeat = wrapper.querySelector('.media-ctrl-btn.repeat');
    var elVolSlider = wrapper.querySelector('.media-vol-slider');
    var elBrowseBtn = wrapper.querySelector('.media-browser-button');
    var elMediaBrowser = wrapper.querySelector('.modal-container');

    var ctrl = makeMediaController(entityId);

    elPlay.onclick = ctrl.playPause;
    elBack.onclick = ctrl.prev;
    elForward.onclick = ctrl.next;
    elShuffle.onclick = ctrl.toggleShuffle;
    elRepeat.onclick = ctrl.cycleRepeat;
    elVol.onclick = ctrl.toggleMute;

    var volDragging = false;

    {{with .Options}}

        {{if enabledByDefault .ShowVolume}}
        if (elVolSlider) {
            elVolSlider.ontouchstart = function() { volDragging = true; };
            elVolSlider.onmousedown  = function() { volDragging = true; };
            elVolSlider.ontouchend   = function() { volDragging = false; };
            elVolSlider.onmouseup    = function() { volDragging = false; };

            var volDebounce;

            elVolSlider.oninput = function() {
                console.log("dragging vol slider!")
                volDragging = true;
                clearTimeout(volDebounce);
                var v = parseFloat(elVolSlider.value);
                volDebounce = setTimeout(function() {
                    ctrl.setVolume(v);
                    volDragging = false;
                }, 150);
            };
        }
        {{end}}

        {{if .ShowBrowser}}
        if (elBrowseBtn) {
            elBrowseBtn.onclick = function() {
                if (elMediaBrowser) { elMediaBrowser.mediaBrowserOpen(); console.log("tried running open on: ", elMediaBrowser) }
            };
        }
        {{end}}

        function renderIdle() {
            elSongInfo.innerHTML = '';
            var idle = document.createElement('span');
            idle.className = 'media-idle on-surface-subtle font-lg';
            idle.textContent = 'Idle';
            elSongInfo.appendChild(idle);
            elIdle = idle;
            elPlay.innerHTML = '{{icon "play"}}';
            if (elCover.querySelector('img')) {
                elCover.removeChild(elCover.querySelector('img'));
            }
            elPlaceholder.style.display = '';
        }

        // Render idle
        ctrl.onUpdate("state", function(state, _) {
            if (state === undefined || state === null || state === "idle") {
                renderIdle();
            } else {
                elIdle.remove();
            }

        })

        // Render pause/play button
        ctrl.onUpdate("state", function(state, _) {
            elPlay.innerHTML = (state === 'playing') ? '{{icon "pause"}}' : '{{icon "play"}}';
        });

        // Render song info
        ctrl.onUpdate(['media_title', 'media_artist', 'media_album_name'], function(state, attrs) {
            var song = attrs.media_title || '';
            var artist = attrs.media_artist || '';

            if (!song && !artist) {
                renderIdle();
                return;
            }

            var elSong = elSongInfo.querySelector('.media-song');
            if (!elSong) {
                elSong = document.createElement('span');
                elSong.className = 'media-song on-surface text-ellipsis font-xl';
                elSongInfo.appendChild(elSong);
            }
            elSong.textContent = song || '—';

            var elArtist = elSongInfo.querySelector('.media-artist');
            if (artist) {
                if (!elArtist) {
                    elArtist = document.createElement('span');
                    elArtist.className = 'media-artist on-surface-muted text-ellipsis font-sm';
                    elSongInfo.appendChild(elArtist);
                }
                elArtist.textContent = artist;
            } else if (elArtist) {
                elSongInfo.removeChild(elArtist);
            }

            {{if disabledByDefault .ShowAlbum}}
            var album = attrs.media_album_name || '';
            var elAlbum = elSongInfo.querySelector('.media-album');
            if (album) {
                if (!elAlbum) {
                    elAlbum = document.createElement('span');
                    elAlbum.className = 'media-album on-surface-subtle text-ellipsis font-xs';
                    elSongInfo.appendChild(elAlbum);
                }
                elAlbum.textContent = album;
            } else if (elAlbum) {
                elSongInfo.removeChild(elAlbum);
            }
            {{end}}
        });


        // Render thumbnail
        ctrl.onUpdate(['entity_picture'], function(state, attrs) {
            var picPath = attrs.entity_picture;
            var existingImg = elCover.querySelector('img');
            if (picPath) {
                var imgSrc = "/api/proxy" + picPath;
                if (existingImg) {
                    if (existingImg.getAttribute('src') !== imgSrc) {
                        existingImg.setAttribute('src', imgSrc);
                    }
                } else {
                    var img = document.createElement('img');
                    img.setAttribute('src', imgSrc);
                    img.setAttribute('alt', '');
                    elCover.appendChild(img);
                }
                elPlaceholder.style.display = 'none';
            } else {
                if (existingImg) { elCover.removeChild(existingImg); }
                elPlaceholder.style.display = '';
            }
        });

        // Render volume/mute
        {{if enabledByDefault .ShowVolume}}
        ctrl.onUpdate(['volume_level', 'is_volume_muted'], function(state, attrs) {
            if (volDragging) { return; }
            var muted = (attrs.is_volume_muted) || (attrs.volume_level === 0);
            if (muted) {
                elVol.innerHTML = '{{icon "volume-mute"}}';
                elVolSlider.classList.add('interactive-disabled-bg', 'interactive-disabled');
                elVolSlider.classList.remove('interactive-muted-bg', 'interactive');
            } else {
                elVol.innerHTML = '{{icon "volume-high"}}';
                elVolSlider.classList.remove('interactive-disabled-bg', 'interactive-disabled');
                elVolSlider.classList.add('interactive-muted-bg', 'interactive');
            }
            if (!volDragging && attrs.volume_level !== undefined) {
                elVolSlider.value = attrs.volume_level;
            }
        });
        {{end}}

    {{end}}

    // Render shuffle/repeat
    ctrl.onUpdate(['shuffle', 'repeat'], function(state, attrs) {
        if (attrs.shuffle !== undefined) {
            elShuffle.classList.remove('hide');
            elShuffle.innerHTML = attrs.shuffle ? '{{icon "shuffle"}}' : '{{icon "shuffle-disabled"}}';
        }
        if (attrs.repeat !== undefined) {
            elRepeat.classList.remove('hide');
            switch (attrs.repeat) {
                case 'off':  elRepeat.innerHTML = '{{icon "repeat-off"}}';  break;
                case 'one':  elRepeat.innerHTML = '{{icon "repeat-once"}}'; break;
                case 'all':  elRepeat.innerHTML = '{{icon "repeat"}}';      break;
            }
        }
    });

});
</script>
{{ end }}