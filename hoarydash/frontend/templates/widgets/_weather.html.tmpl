{{define "weather-widget"}}
{{if once "weather-widget-style"}}
<style>
  .weather-container {
    overflow: hidden;
    font-family: inherit;
  }

  .weather-main {
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    -webkit-box-align: stretch;
    -webkit-align-items: stretch;
    align-items: stretch;
    padding: 0.7em 0;
    justify-content: center;
  }

  .weather-current {
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    -webkit-box-align: center;
    -webkit-align-items: center;
    align-items: center;
    -webkit-box-flex: 0;
    -webkit-flex: 0 0 auto;
    flex: 0 0 auto;
  }
  .weather-current > div {
    margin: 0 0.2em 0 0.2em;
  }

  .weather-icon {
    font-size: 1.8em;
    line-height: 1;
  }

  .weather-temp {
    font-size: 1.9em;
    font-weight: 700;
    color: #f0e0c0;
    line-height: 1;
  }

  .weather-temp-unit {
    font-size: 0.9em;
    font-weight: 400;
    color: #a08060;
  }

  .weather-divider {
    width: 0.1em;
    background: rgba(120, 180, 255, 0.15);
    -webkit-align-self: stretch;
    align-self: stretch;
    -webkit-flex-shrink: 0;
    flex-shrink: 0;
    margin: 0 0.6em;
  }

  .weather-details {
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    -webkit-box-orient: vertical;
    -webkit-flex-direction: column;
    flex-direction: column;
    -webkit-box-pack: center;
    -webkit-justify-content: center;
    justify-content: center;
    -webkit-box-flex: 1;
  }

  .weather-details > div {
    margin: 0 0.1em 0 0.1em;
  }

  .weather-condition {
    font-size: 0.65em;
    font-weight: 600;
    color: #d0c8b8;
    text-transform: capitalize;
  }

  .weather-meta {
    font-size: 0.55em;
    color: #8899aa;
  }

  .weather-meta span {
    margin-right: 0.5em;
  }

  .weather-forecast {
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    overflow: scroll;
  }

  .forecast-day {
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    -webkit-box-orient: horizontal;
    -webkit-flex-direction: row;
    flex-direction: row;
    -webkit-box-align: center;
    -webkit-align-items: center;
    align-items: center;
  }
  .forecast-day-content {
    -webkit-box-flex: 1;
    -webkit-flex: 1;
    flex: 1;
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    -webkit-box-orient: vertical;
    -webkit-flex-direction: column;
    flex-direction: column;
    -webkit-box-align: center;
    -webkit-align-items: center;
    align-items: center;
    padding-right: 1.3em !important;
    padding-left: 1.3em !important;
  }
  
  .forecast-day-name {
    font-size: 0.45em;
    color: #8899aa;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.2em;
    white-space: nowrap;
  }

  .forecast-day-icon {
    font-size: 0.8em;
    line-height: 1.2;
    margin-bottom: 0.2em;
  }

  .forecast-day-temps {
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    -webkit-box-align: baseline;
    -webkit-align-items: baseline;
    align-items: baseline;
  }
  .forecast-day-temps {
    margin: 0 0.1em 0 0.1em;
  }

  .forecast-temp-high {
    font-size: 0.55em;
    font-weight: 600;
    color: #d0c0a0;
  }

  .forecast-temp-low {
    font-size: 0.5em;
    color: #6a7a8a;
  }
</style>
{{end}}
<div class="weather-container widget card border card-wrapper">
  <div class="weather-main widget card card-inner">
    <div class="weather-current">
      <div class="weather-icon">🌡️</div>
      <div>
        <span class="weather-temp on-surface">--</span><span class="weather-temp-unit on-surface-muted">°C</span>
      </div>
    </div>
    <div class="weather-divider"></div>
    <div class="weather-details">
      <div class="weather-condition accent-muted">Loading...</div>
      <div class="weather-meta on-surface-muted">
        <span class="weather-wind"></span>
        <span class="weather-humidity"></span>
        <span class="weather-feels"></span>
      </div>
    </div>
  </div>
  <div class="divider horizontal thin"></div>
  <div class="weather-forecast">
    
    <div class="forecast-day template">
      <div class="forecast-day-content widget card card-inner ">
        <div class="forecast-day-name on-surface">  timeLabel </div>
        <div class="forecast-day-icon">  icon    </div>
        <div class="forecast-day-temps">
          <span class="forecast-temp-high on-surface"> high </span>
          <span class="forecast-temp-low on-surface-muted"> low </span>
        </div>
      </div>
      {{if .InternalBorders}}
        <div class="divider vertical thin"></div>
      {{end}}
    </div>
  </div>
</div>

<script>
component(function(wrapper) {
  var POLL_INTERVAL = 10 * 60 * 1000;
  var entityId = {{.EntityID}};
  if (!entityId) { return; }

  var locale   = window.CONFIG.locale   || navigator.language || 'en-US';
  var timezone = window.CONFIG.timezone || Intl.DateTimeFormat().resolvedOptions().timeZone;

  var forecastEl = wrapper.querySelector(".weather-forecast");
  var forecastDayTmpl = wrapper.querySelector(".forecast-day.template");

  var conditionIcons = {
    'clear-night':     '🌙',
    'cloudy':          '☁️',
    'exceptional':     '⚠️',
    'fog':             '🌫️',
    'hail':            '🌨️',
    'lightning':       '⚡',
    'lightning-rainy': '⛈️',
    'partlycloudy':    '⛅',
    'pouring':         '🌧️',
    'rainy':           '🌦️',
    'snowy':           '❄️',
    'snowy-rainy':     '🌨️',
    'sunny':           '☀️',
    'windy':           '🌬️',
    'windy-variant':   '🌬️'
  };

  function iconForCondition(condition) {
    return conditionIcons[condition] || '🌡️';
  }

  function round1(n) {
    return Math.round(parseFloat(n) * 10) / 10;
  }

  function dayNameFromDatetime(datetimeStr) {
    var date = new Date(datetimeStr);
    return date.toLocaleDateString(locale, {
      weekday: 'short',
      timeZone: timezone
    });
  }
  
  function isHourlyForecast(forecasts) {
      if (!forecasts || forecasts.length < 2) { return false; }
      var a = new Date(forecasts[0].datetime);
      var b = new Date(forecasts[1].datetime);
      return a.toDateString() === b.toDateString();
  }

  function formatForecastTime(datetimeStr, hourly) {
      var date = new Date(datetimeStr);
      if (hourly) {
          return date.toLocaleTimeString(locale, {
              hour: '2-digit',
              minute: '2-digit',
              timeZone: timezone,
              hour12: {{disabledByDefault .Hour12}},
              weekday: 'short',
          });
      }
      return date.toLocaleDateString(locale, {
          weekday: 'short',
          timeZone: timezone
      });
  }

  function renderCurrent(state, attributes) {
    var condLabel = translations[state] || (state || '').replace(/-/g, ' ');
    wrapper.querySelector('.weather-icon').textContent      = iconForCondition(state);
    wrapper.querySelector('.weather-temp').textContent      = round1(attributes.temperature || 0);
    wrapper.querySelector('.weather-condition').textContent = condLabel;
    wrapper.querySelector('.weather-wind').textContent      = attributes.wind_speed
      ? '💨 ' + attributes.wind_speed + ' ' + (attributes.wind_speed_unit || 'm/s')
      : '';
    wrapper.querySelector('.weather-humidity').textContent  = attributes.humidity
      ? '💧 ' + attributes.humidity + '%'
      : '';
    wrapper.querySelector('.weather-feels').textContent     = attributes.apparent_temperature
      ? 'Feels ' + round1(attributes.apparent_temperature) + '°'
      : '';
  }

  function clearOldForecast() {
    var nodes = forecastEl.querySelectorAll("li");
    console.log("nodes in clear old forecast: ", nodes)
    for (var i = nodes.length - 1; i >= 1; i--) { // stop at 1 to not remove todo template
        var node = nodes[i];
        var id = node.id.slice(5);

        if (!todoIds.has(id)) {
            node.parentNode.removeChild(node);
        }
    }
}

  function renderForecast(forecast) {
    if (!forecast || !forecast.length) {
      forecastEl.style.display = 'none';
      return;
    }
    clearOldForecast();

    var days = forecast.slice(0, {{.ForecastTimes | default 3}});
    var hourly = isHourlyForecast(forecast);
    for (var i = 0; i < days.length; i++) {
      var dayEl = forecastDayTmpl.cloneNode(true);
      dayEl.classList.remove("template");

      var day       = days[i];
      var dayName   = dayNameFromDatetime(day.datetime);
      var timeLabel = formatForecastTime(day.datetime, hourly);
      var icon      = iconForCondition(day.condition);
      var high      = day.temperature !== undefined ? Math.round(day.temperature) + '°' : '--';
      var low       = day.templow     !== undefined ? Math.round(day.templow)     + '°' : '';

      dayEl.querySelector(".forecast-day-name").textContent = timeLabel;
      dayEl.querySelector(".forecast-day-icon").textContent = icon;
      dayEl.querySelector(".forecast-temp-high").textContent = high;
      var lowEl = dayEl.querySelector(".forecast-temp-low");
      if (low) {
        lowEl.textContent = low;
      } else {
        lowEl.remove();
      }
      
      
      forecastEl.appendChild(dayEl);
    }
  }

  var translations = {{domainTranslations "weather"}};

   function fetchForecast() {
    return window.haSend({
      type: 'call_service',
      domain: 'weather',
      service: 'get_forecasts',
      service_data: { type: {{.ForecastInterval | default "daily"}} },
      target: { entity_id: entityId },
      return_response: true
    }).then(function(result) {
      var forecasts = result.response
        && result.response[entityId]
        && result.response[entityId].forecast;
      renderForecast(forecasts || []);
    });
  }

  var MAX_TRIES = 15;
  var tries = 0;
  function tryFetch() {
    {{/* console.log("ran tryFetch") */}}
    if (tries >= MAX_TRIES) {
        {{/* console.log("max tries reached, cooling down") */}}
        setTimeout(function() {tries = 0; tryFetch()}, 3 * 60 * 1000)
        return;
    }
    if (window.haSocketReady) {
          fetchForecast();
        {{/* console.log("tried running fetchWeather") */}}
    } else {
        ++tries;
        setTimeout(tryFetch, 1000);
    }
  }

  window.entityListeners[entityId].push(function(state, attributes) {
      if (state !== undefined) { renderCurrent(state, attributes); }
  });

  window.onHaReady.push(function() {
      fetchForecast();
      setInterval(fetchForecast, POLL_INTERVAL);
  });

  tryFetch();
});
</script>
{{end}}