{{define "fullscreen-media-layout"}}
{{if once "fullscreen-media-layout-style"}}
<style>
    .fml-container {
        position: relative;
    }

    .fml-backdrop {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        z-index: 0;
        overflow: hidden;
    }

    .fml-backdrop-art {
        position: absolute;
        top: -15%;
        left: -15%;
        width: 130%;
        height: 130%;
        object-fit: cover;
        -webkit-filter: blur(2em) brightness(0.65);
        filter: blur(2em) brightness(0.65);
        display: none;
    }

    .fml-backdrop-art.loaded {
        display: block;
    }

    .fml-backdrop-scrim {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: -webkit-linear-gradient(top, rgba(0,0,0,0.25) 0%, rgba(0,0,0,0.65) 70%);
        background: linear-gradient(to bottom, rgba(0,0,0,0.25) 0%, rgba(0,0,0,0.65) 70%);
    }

    .fml-layout {
        position: relative;
        z-index: 1;
        height: 100%;
        margin: 26px;
        margin-bottom: 2.25em;
    }

    .fml-top-row {
        margin-bottom: auto;
    }


    .fml-badges > .badge > * {
        font-size: 1em;
        font-weight: unset;
        margin: 0 0.2em;
    }

    .fml-browse-btn:active {
        opacity: 0.6;
    }

    .fml-browse-btn .icon {
        margin-right: 0.4em;
    }

    .fml-cover {
        width: 11.5em;
        height: 11.5em;
        background: rgba(255,255,255,0.08);
        overflow: hidden;
    }

    .fml-cover img {
        object-fit: cover;
        display: block;
    }


    .fml-song-block {
        min-width: 0;
    }

    .fml-song-title {
        font-weight: 600;
        display: block;
    }

    .fml-song-artist {
        display: block;
    }

    .fml-song-album {
        display: block;
        margin-top: 0.1em;
    }

    .fml-idle {
        font-style: italic;
    }

    .fml-transport {
        margin-left: -0.2em;
    }

    .fml-ctrl-btn:active {
        opacity: 0.5;
    }

    .fml-ctrl-btn.fml-play {
        font-size: 1.75em;
    }

    .fml-ctrl-btn.fml-aux {
        opacity: 0.5;
    }

    .fml-ctrl-btn.fml-active {
        opacity: 1;
    }

    .fml-vol {
        margin-left: 0.2em;
    }

    .fml-vol-slider {
        height: 0.5em;
        border-radius: 0.2em;
        outline: none;
        margin: 0 0.6em;
        cursor: pointer;
    }

    {{ $thumbStyle := "width: 1.6em; height: 1.6em;" | css}}
    .fml-vol-slider::-webkit-slider-thumb { {{$thumbStyle}} }
    .fml-vol-slider::-moz-range-thumb { {{$thumbStyle}} }

    .fml-progress-row {
        width: 100%;
    }

    .fml-progress-duration {
        min-width: 4ch;
    }
    .fml-progress-duration.left {
        text-align: right;
    }

    .fml-progress-bar {
        position: relative;
        height: 0.3em;
        border-radius: 0.2em;
        flex: 1;
        margin: 0 0.15em;
        margin-top: 0.15em;
    }
     .fml-progress-bar > input {
        position: absolute;
        opacity: 0;
        z-index: 3;
        background-color: transparent;
     }

     {{$thumbStyle := "height: 1.2em; width: 1.2em;" | css}}
     .fml-progress-bar > input[type=range]::-webkit-slider-thumb { {{$thumbStyle}} }
     .fml-progress-bar > input[type=range]::-moz-range-thumb { {{$thumbStyle}} }

    .fml-progress-bar-elapsed {
        position: absolute;
        border-radius: inherit;
        width: 0;
        height: 100%;
    }
</style>
{{end}}
{{template "media-controller"}}
<div class="fml-container size-full flex flex-col">
    <div class="fml-backdrop">
        <img class="fml-backdrop-art" src="" alt="" />
        <div class="fml-backdrop-scrim"></div>
    </div>

    <div class="fml-layout navbar-padding flex flex-col justify-between">
        <div class="fml-top-row flex flex-row justify-between align-start">
            {{if enabledByDefault .Dateclock.Enabled}}
            <div class="fml-clock">
                {{template "dateclock" mergeDateclock (dict
                    "Align"      "left"
                    "FontSize"   1.3
                    "TimeSize"   2.0
                    "TimeWeight" 400
                    "DateSize"   1.0
                    "DateWeight" 300
                ) .Dateclock}}
            </div>
            {{else}}
            <div></div>
            {{end}}

            <div class="fml-top-right flex flex-col align-end justify-end gap-outer gap-vertical">
                {{if .Badges}}
                <div class="fml-badges gap-outer gap-horizontal flex flex-row align-center justify-end">
                    <div class="fml-badge surface-subtle on-surface-muted badge border gap-outer gap-horizontal">
                        <div class="fml-badge-icon icon">{{icon .Badges.Badge.Icon}}</div>
                        <span class="fml-badge-name">{{.Badges.Badge.Label}}</span>
                    </div>
                    {{if .Badges.Sensors}}
                    {{range .Badges.Sensors}}
                        <div class="fml-sensor surface-subtle on-surface-muted badge border gap-outer gap-horizontal">
                            {{if .Icon}}
                            <div class="fml-sensor-icon icon">{{icon .Icon}}</div>
                            {{end}}
                            {{if .Label}}
                            <span class="fml-sensor-name">{{.Label}}</span>
                            {{end}}
                            <span class="fml-sensor-value sensor-value"></span>
                            {{if .Unit}}
                            <span class="fml-sensor-unit">{{.Unit}}</span>
                            {{end}}
                        </div>
                        {{template "_sensor-script" .}}
                    {{end}}
                    {{end}}
                </div>
                {{end}}
                <button class="fml-source-btn surface-subtle on-surface-muted badge-btn border">
                    <div class="fml-source-icon icon">{{icon "speaker-multiple"}}</div>
                    <span class="fml-source-name">-</span>
                </button>
                
                {{if .ShowBrowser}}
                <button class="fml-browse-btn surface-subtle on-surface-muted badge-btn border">
                    {{icon "play-box-multiple"}}
                    <span>{{translate "media:browse"}}</span>
                </button>
                <div class="fml-media-browser">{{template "media-browser" .}}</div>
                {{end}}
                <div class="fml-source-browser">{{template "modal"}}</div>
            </div>
        </div>

        
        <div class="fml-bottom gap-outer gap-vertical">
            <div class="fml-media gap-outer gap-vertial flex flex-row align-end gap-inner gap-horizontal">
                <div class="fml-cover border-tight border-thin border gap-outer gap-horizontal flex flex-shrink-0 align-center justify-center">
                    <div class="fml-cover-placeholder accent font-xxl">{{icon "music"}}</div>
                </div>
                <div class="fml-song-block flex-grow">
                    <span class="fml-idle on-surface-subtle font-xl">Idle</span>
                </div>
            </div>

            <div class="fml-controls-row font-xl flex flex-row align-center justify-start gap-outer gap-horizontal">
                <div class="fml-transport gap-horizontal gap-inner flex flex-row align-center">
                    <button class="fml-ctrl-btn btn icon gap-horizontal gap-inner fml-aux shuffle on-surface-subtle" title="Shuffle">{{icon "shuffle"}}</button>
                    <button class="fml-ctrl-btn btn icon gap-horizontal gap-inner back on-surface-muted" title="Previous">{{icon "skip-backward"}}</button>
                    <button class="gap-horizontal gap-inner btn" title="Play / Pause">
                        <div class="fml-ctrl-btn icon fml-play play on-surface icon">{{icon "play-circle"}}</div>
                    </button>
                    <button class="fml-ctrl-btn btn icon gap-horizontal gap-inner forward on-surface-muted" title="Next">{{icon "skip-forward"}}</button>
                    <button class="fml-ctrl-btn btn icon gap-horizontal gap-inner fml-aux repeat on-surface-subtle" title="Repeat">{{icon "repeat"}}</button>
                </div>
                <div class="fml-vol gap-horizontal gap-inner flex flex-row align-center">
                    <span class="accent-muted icon">{{icon "volume-low"}}</span>
                    <input class="fml-vol-slider interactive-muted-bg interactive-thumb thumb flex-grow" type="range" min="0" max="1" step="0.02" value="0.5" />
                    <span class="accent-muted icon">{{icon "volume-high"}}</span>
                </div>
            </div>
            <div class="fml-progress-row on-surface transition-fast flex align-center">
                <span class="fml-progress-duration elapsed">1:00</span>
                <div class="fml-progress-bar surface-alt">
                    <input class="thumb surface-alt size-full" type="range" min="0" max="100" step="1" value="0"/>
                    <div class="fml-progress-bar-elapsed surface-prominent"></div>
                </div>
                <span class="fml-progress-duration left">-2:00</span>
            </div>
        </div>
    </div>
</div>
<script>
component(function(wrapper) {
    var entityId = '{{.EntityID}}';
    if (!entityId) { return; }

    var ctrl = makeMediaController(entityId{{if .Spotifyplus}}, { spotifyPlus: true }{{end}});
    var progressInterval;
    var currentDuration;

    var elBackdropArt   = wrapper.querySelector('.fml-backdrop-art');
    var elCoverWrap     = wrapper.querySelector('.fml-cover');
    var elCoverPH       = wrapper.querySelector('.fml-cover-placeholder');
    var elSongBlock     = wrapper.querySelector('.fml-song-block');
    var elSourceName    = wrapper.querySelector('.fml-source-name');
    var elPlay          = wrapper.querySelector('.fml-ctrl-btn.play');
    var elShuffle       = wrapper.querySelector('.fml-ctrl-btn.shuffle');
    var elRepeat        = wrapper.querySelector('.fml-ctrl-btn.repeat');
    var elVolSlider     = wrapper.querySelector('.fml-vol-slider');
    var elMediaBrowser  = wrapper.querySelector('.fml-media-browser .modal-container');
    console.log("media browser element: ", elMediaBrowser)
    var elSourceBrowser = wrapper.querySelector('.fml-source-browser .modal-container');
    var elTimeElapsed   = wrapper.querySelector('.fml-progress-duration.elapsed');
    var elTimeLeft      = wrapper.querySelector('.fml-progress-duration.left');
    var elElapsedBar    = wrapper.querySelector('.fml-progress-bar-elapsed');
    var elProgressInput = wrapper.querySelector('.fml-progress-bar > input');
    var elSourceBtn     = wrapper.querySelector('.fml-source-btn'); 

    // transport buttons
    wrapper.querySelector('.fml-ctrl-btn.back').onclick = ctrl.prev;
    wrapper.querySelector('.fml-ctrl-btn.forward').onclick = ctrl.next;
    elPlay.onclick = ctrl.playPause;
    elShuffle.onclick = ctrl.toggleShuffle;
    elRepeat.onclick = ctrl.cycleRepeat;

    var volDragging = false;
    if (elVolSlider) {
        elVolSlider.ontouchstart = function() { volDragging = true; };
        elVolSlider.onmousedown  = function() { volDragging = true; };
        elVolSlider.ontouchend   = function() { volDragging = false; };
        elVolSlider.onmouseup    = function() { volDragging = false; };

        var volDebounce;

        elVolSlider.oninput = function() {
            console.log("dragging vol slider!")
            volDragging = true;
            clearTimeout(volDebounce);
            var v = parseFloat(elVolSlider.value);
            volDebounce = setTimeout(function() {
                ctrl.setVolume(v);
                volDragging = false;
            }, 150);
        };
    }

    var progressDragging = false;

    function progressDrag () {
        if (progressInterval) {
            clearInterval(progressInterval);
        }
        elProgressInput.style.opacity = 1;
        elProgressInput.classList.add("interactive-muted-thumb");
        elElapsedBar.classList.remove("surface-prominent");
        elElapsedBar.classList.add("accent-bg");
        progressDragging = true;
    }

    function progressRelease () {
        elProgressInput.style.opacity = 0;
        elProgressInput.classList.remove("interactive-muted-thumb");
        elElapsedBar.classList.add("surface-prominent");
        elElapsedBar.classList.remove("accent-bg");
        progressDragging = false;
    }

    elProgressInput.ontouchstart = progressDrag;
    elProgressInput.onmousedown  = progressDrag;
    elProgressInput.ontouchend   = progressRelease;
    elProgressInput.onmouseup    = progressRelease;

    elProgressInput.oninput = function() {
        if (progressInterval) {
            clearInterval(progressInterval);
            if (!currentDuration) return;
        }

        var val = parseFloat(elProgressInput.value) || 0;
        var pct = (val / currentDuration) * 100;

        elElapsedBar.style.width = pct + '%';
    }

    elProgressInput.onchange = function() { 
        progressDragging = false;
        ctrl.seek(parseFloat(elProgressInput.value)); 
    };

    var elSourceBrowserHeader = document.createElement('div')
    elSourceBrowserHeader.textContent = "{{translate "media:sources"}}"; 
    elSourceBrowserHeader.classList.add('accent');
    elSourceBrowserHeader.style.fontSize = '1.8em';
    elSourceBrowser.querySelector('.modal-header').appendChild(elSourceBrowserHeader);
    elSourceBtn.onclick = elSourceBrowser.open;
    

    {{if .ShowBrowser}}
    var elBrowseBtn = wrapper.querySelector('.fml-browse-btn');
    if (elBrowseBtn) {
        elBrowseBtn.onclick = function() {
            if (elMediaBrowser) { console.log("tried running open on: ", elMediaBrowser); elMediaBrowser.mediaBrowserOpen();  }
        };
    }
    {{end}}

    {{if disabledByDefault .Rotate}}
    var backdropRotationDeg = 0;
    setInterval(function() {
        elBackdropArt.style.transform = "rotate(" + backdropRotationDeg + "deg)"
        backdropRotationDeg += 0.1;
    }, 100);
    {{end}}

    function formatMin(seconds) {
        var minutes = 0;
        while (seconds > 60) {
            ++minutes;
            seconds -= 60;
        }
        var secondsString = seconds < 10 ? "0" + seconds.toString() : seconds.toString();
        return minutes.toString() + ":" + secondsString;
    }

    function renderProgress(elapsed, duration) {
        var left = duration - elapsed;
        var pct = (elapsed / duration) * 100;

        elTimeElapsed.textContent = formatMin(elapsed);
        elTimeLeft.textContent = '-' + formatMin(left);
        elElapsedBar.style.width = pct + '%';
    }

    function progressUpdater(position, duration) {
        if (progressInterval) {
            clearInterval(progressInterval);
        }
        renderProgress(position, duration)
        progressInterval = setInterval(function(){
            ++position;
            renderProgress(position, duration);
        }, 1000)
    }

    // play/pause state
    ctrl.onUpdate(null, function(state, _) {
        if (state == 'playing') {
            elPlay.innerHTML = '{{icon "pause-circle"}}'
        } else {
            elPlay.innerHTML = '{{icon "play-circle"}}'
            if (progressInterval) {
                clearInterval(progressInterval);
            }
        }
    });

    // song info
    ctrl.onUpdate(['media_title', 'media_artist', 'media_album_name'], function(state, attrs) {
        var title  = attrs.media_title   || '';
        var artist = attrs.media_artist  || '';
        var album  = attrs.media_album_name || '';

        if (!title && !artist) {
            elSongBlock.innerHTML = '<span class="fml-idle on-surface-subtle">Idle</span>';
            return;
        }
        var html = '';
        if (title)  { html += '<span class="fml-song-title on-surface font-xxl">'  + title  + '</span>'; }
        if (artist) { html += '<span class="fml-song-artist on-surface-muted font-xl">' + artist + '</span>'; }
        {{if enabledByDefault .ShowAlbum}}
        if (album)  { html += '<span class="fml-song-album on-surface-subtle font-lg">' + album  + '</span>'; }
        {{end}}
        elSongBlock.innerHTML = html;
    });

    // track progress
    ctrl.onUpdate(['media_duration', 'media_position'], function(state, attrs) {
        if (state !== "playing") return;
        if (progressInterval) {
            clearInterval(progressInterval);
        }
        
        var duration = attrs.media_duration;
        var position = attrs.media_position;

        progressUpdater(position, duration)
        
        currentDuration = duration;
        if (progressDragging) return;
        elProgressInput.value = position;
        elProgressInput.max = duration;
    })

    // cover art + backdrop blur
    ctrl.onUpdate(['entity_picture'], function(state, attrs) {
        if (attrs.entity_picture) {
            var haBase = (function() {
                var cfgUrl = window.CONFIG && window.CONFIG.haUrl;
                if (cfgUrl) { return cfgUrl; }
                return window.location.origin.replace(/:\d+$/, ':8123');
            })();
            var src = haBase + attrs.entity_picture;

            // backdrop blur art
            elBackdropArt.src = src;
            elBackdropArt.className = 'fml-backdrop-art';
            elBackdropArt.onload = function() {
                elBackdropArt.className = 'fml-backdrop-art loaded';
            };

            // cover art in the card
            var img = elCoverWrap.querySelector('img');
            if (!img) {
                img = document.createElement('img');
                img.alt = '';
                img.classList = 'size-full'
                elCoverWrap.insertBefore(img, elCoverWrap.firstChild);
            }
            img.src = src;
            elCoverPH.style.display = 'none';
        } else {
            elBackdropArt.src = '';
            elBackdropArt.className = 'fml-backdrop-art';
            var img = elCoverWrap.querySelector('img');
            if (img) { elCoverWrap.removeChild(img); }
            elCoverPH.style.display = '';
        }
    });

    // source / app name
    ctrl.onUpdate(['source'], function(state, attrs) {
        elSourceName.textContent = attrs.source || '–';
    });

    ctrl.onUpdate(['source_list'], function(state, attrs) {
        var sourcesNodes = []
        for (source of attrs.source_list) {
            (function(source) {
                var node = document.createElement('div');
                var contentSpan = document.createElement('div');

                contentSpan.textContent = source;
                contentSpan.classList = "interactive";
                node.appendChild(contentSpan);

                node.onclick = function() {
                    console.log("sending set source with source: ", source)
                    ctrl.setSource(source);
                    elSourceBrowser.close();
                }
                sourcesNodes.push(node);
            }(source))
        }
        elSourceBrowser.renderList(sourcesNodes);
    })

    // volume
    ctrl.onUpdate(['volume_level', 'is_volume_muted'], function(state, attrs) {
        if (!elVolSlider || volDragging) { return; }
        if (attrs.is_volume_muted) {
            elVolSlider.value = 0;
        } else if (typeof attrs.volume_level !== 'undefined') {
            elVolSlider.value = attrs.volume_level;
        }
    });

    // shuffle / repeat active state
    ctrl.onUpdate(['shuffle', 'repeat'], function(state, attrs) {
        if (attrs.shuffle) {
            elShuffle.className = elShuffle.className.replace(' fml-active', '') + ' fml-active accent';
        } else {
            elShuffle.className = elShuffle.className.replace(' fml-active accent', '') + ' on-surface-subtle';
        }
        var rep = attrs.repeat || 'off';
        if (rep !== 'off') {
            elRepeat.className = elRepeat.className.replace(' fml-active', '') + ' fml-active accent';
            elRepeat.innerHTML = (rep === 'one')
                ? '{{icon "repeat-once"}}'
                : '{{icon "repeat"}}';
        } else {
            elRepeat.className = elRepeat.className.replace(' fml-active accent', '') + ' on-surface-subtle';
            elRepeat.innerHTML = '{{icon "repeat"}}';
        }
    });
});
</script>
{{end}}