{{define "fullscreen-media-layout"}}
{{if once "fullscreen-media-layout-style"}}
<style>
    .fml-container {
        position: relative;
        width: 100%;
        height: 100%;
        overflow: hidden;
        display: -webkit-box;
        display: -webkit-flex;
        display: flex;
        -webkit-box-orient: vertical;
        -webkit-flex-direction: column;
        flex-direction: column;
    }

    .fml-backdrop {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        z-index: 0;
        overflow: hidden;
    }

    .fml-backdrop-art {
        position: absolute;
        top: -15%;
        left: -15%;
        width: 130%;
        height: 130%;
        object-fit: cover;
        -webkit-filter: blur(2em) brightness(0.35) saturate(1.4);
        filter: blur(2em) brightness(0.35) saturate(1.4);
        display: none;
    }

    .fml-backdrop-art.loaded {
        display: block;
    }

    .fml-backdrop-scrim {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: -webkit-linear-gradient(top, rgba(0,0,0,0.25) 0%, rgba(0,0,0,0.65) 70%);
        background: linear-gradient(to bottom, rgba(0,0,0,0.25) 0%, rgba(0,0,0,0.65) 70%);
    }

    .fml-layout {
        position: relative;
        z-index: 1;
        display: -webkit-box;
        display: -webkit-flex;
        display: flex;
        -webkit-box-orient: vertical;
        -webkit-flex-direction: column;
        flex-direction: column;
        height: 100%;
        margin: 26px;
        margin-bottom: 2.25em;
        -webkit-box-sizing: border-box;
        box-sizing: border-box;
    }

    .fml-clock .dateclock-container {
        align-items: start;
        font-size: 1.3em;
    }
    .fml-clock  .clock {
        font-size: 2em;
        font-weight: 400;
    }

    .fml-clock .date {
        font-size: 1em;
        font-weight: 300;
    }

    .fml-top-row {
        display: -webkit-box;
        display: -webkit-flex;
        display: flex;
        -webkit-box-orient: horizontal;
        -webkit-flex-direction: row;
        flex-direction: row;
        -webkit-box-pack: justify;
        -webkit-justify-content: space-between;
        justify-content: space-between;
        -webkit-box-align: start;
        -webkit-align-items: flex-start;
        align-items: flex-start;
        margin-bottom: auto;
    }

    .fml-top-right {
        display: -webkit-box;
        display: -webkit-flex;
        display: flex;
        -webkit-box-orient: vertical;
        -webkit-flex-direction: column;
        flex-direction: column;
        -webkit-box-align: end;
        -webkit-align-items: flex-end;
        align-items: flex-end;
        gap: 0.5em;
    }

    .fml-source-badge {
        display: -webkit-box;
        display: -webkit-flex;
        display: flex;
        -webkit-box-orient: horizontal;
        -webkit-flex-direction: row;
        flex-direction: row;
        -webkit-box-align: center;
        -webkit-align-items: center;
        align-items: center;
        gap: 0.4em;
        font-size: 0.65em;
        padding: 0.35em 0.75em;
        border-radius: 2em;
        border: 0.05em solid rgba(255,255,255,0.15);
        background: rgba(255,255,255,0.08);
    }

    .fml-source-dot {
        -webkit-flex-shrink: 0;
        flex-shrink: 0;
        display: flex;
        align-items: center;
    }

    .fml-browse-btn {
        background: rgba(255,255,255,0.07);
        border: 0.05em solid rgba(255,255,255,0.12);
        border-radius: 0.4em;
        font-size: 0.7em;
        padding: 0.4em 0.8em;
        cursor: pointer;
        display: -webkit-box;
        display: -webkit-flex;
        display: flex;
        -webkit-box-align: center;
        -webkit-align-items: center;
        align-items: center;
        gap: 0.4em;
        -webkit-tap-highlight-color: transparent;
    }

    .fml-browse-btn:active {
        opacity: 0.6;
    }

    .fml-mid {
        display: -webkit-box;
        display: -webkit-flex;
        display: flex;
        -webkit-box-orient: horizontal;
        -webkit-flex-direction: row;
        flex-direction: row;
        -webkit-box-align: end;
        -webkit-align-items: flex-end;
        align-items: flex-end;
        gap: 1.2em;
        padding-bottom: 1em;
    }

    .fml-cover {
        width: 10.5em;
        height: 10.5em;
        -webkit-flex-shrink: 0;
        flex-shrink: 0;
        border-radius: 0.4em;
        background: rgba(255,255,255,0.08);
        overflow: hidden;
        border: 0.05em solid rgba(255,255,255,0.12);
        display: -webkit-box;
        display: -webkit-flex;
        display: flex;
        -webkit-box-align: center;
        -webkit-align-items: center;
        align-items: center;
        -webkit-box-pack: center;
        -webkit-justify-content: center;
        justify-content: center;
    }

    .fml-cover img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .fml-cover-placeholder {
        font-size: 2.2em;
    }

    .fml-song-block {
        -webkit-box-flex: 1;
        -webkit-flex: 1;
        flex: 1;
        min-width: 0;
        font-size: 1.4em;
    }

    .fml-song-title {
        font-size: 1.2em;
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: block;
        margin-bottom: 0.2em;
    }

    .fml-song-artist {
        font-size: 0.82em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: block;
    }

    .fml-song-album {
        font-size: 0.68em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: block;
        margin-top: 0.1em;
        opacity: 0.7;
    }

    .fml-idle {
        font-size: 0.85em;
        font-style: italic;
    }

    .fml-bottom {
        padding-top: 0.8em;
    }

    .fml-controls-row {
        display: -webkit-box;
        display: -webkit-flex;
        display: flex;
        -webkit-box-orient: horizontal;
        -webkit-flex-direction: row;
        flex-direction: row;
        -webkit-box-align: center;
        -webkit-align-items: center;
        align-items: center;
        -webkit-box-pack: justify;
        -webkit-justify-content: space-between;
        justify-content: space-between;
        margin-bottom: 0.7em;
    }

    .fml-transport {
        display: -webkit-box;
        display: -webkit-flex;
        display: flex;
        -webkit-box-orient: horizontal;
        -webkit-flex-direction: row;
        flex-direction: row;
        -webkit-box-align: center;
        -webkit-align-items: center;
        align-items: center;
        margin-left: -0.2em;
    }

    .fml-ctrl-btn {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 1.2em;
        line-height: 1;
        padding: 0.2em 0.35em;
        -webkit-tap-highlight-color: transparent;
    }

    .fml-ctrl-btn:active {
        opacity: 0.5;
    }

    .fml-ctrl-btn.fml-play {
        font-size: 1.9em;
    }

    .fml-ctrl-btn.fml-aux {
        font-size: 1em;
        opacity: 0.5;
    }

    .fml-ctrl-btn.fml-active {
        opacity: 1;
    }

    .fml-vol-row {
        display: -webkit-box;
        display: -webkit-flex;
        display: flex;
        -webkit-box-orient: horizontal;
        -webkit-flex-direction: row;
        flex-direction: row;
        -webkit-box-align: center;
        -webkit-align-items: center;
        align-items: center;
        gap: 0.6em;
        font-size: 0.9em;
    }

    .fml-vol-slider {
        -webkit-appearance: none;
        -webkit-flex: 1;
        flex: 1;
        height: 0.4em;
        border-radius: 0.2em;
        outline: none;
        cursor: pointer;
    }

    .fml-vol-slider::-webkit-slider-thumb {
        -webkit-appearance: none;
        width: 1.6em;
        height: 1.6em;
        border-radius: 50%;
        border: none;
        cursor: pointer;
    }

    .fml-vol-slider::-moz-range-thumb {
        width: 1.6em;
        height: 1.6em;
        border-radius: 50%;
        border: none;
        cursor: pointer;
    }
</style>
{{end}}
{{template "media-controller"}}


<div class="fml-container">
    <div class="fml-backdrop">
        <img class="fml-backdrop-art" src="" alt="" />
        <div class="fml-backdrop-scrim"></div>
    </div>

    <div class="fml-layout navbar-padding">
        <div class="fml-top-row">
            {{if enabledByDefault .Screen.Dateclock.Enabled}}
            <div class="fml-clock">
                {{template "_dateclock"}}
                {{template "dateclock-controller" .Screen.Dateclock}}
            </div>
            {{else}}
            <div></div>
            {{end}}

            <div class="fml-top-right">
                <div class="fml-source-badge surface-subtle on-surface-muted">
                    <div class="fml-source-dot state on">{{icon .Screen.Entity.Badge}}</div>
                    <span class="fml-source-name">{{.Screen.Entity.Label }}</span>
                </div>
                {{if .Screen.Entity.ShowBrowser}}
                <button class="fml-browse-btn surface-subtle on-surface-muted">
                    {{icon "play-box-multiple"}}
                    <span>Browse</span>
                </button>
                {{end}}
            </div>
        </div>

        <div class="fml-mid">
            <div class="fml-cover">
                <div class="fml-cover-placeholder accent">{{icon "music"}}</div>
            </div>
            <div class="fml-song-block">
                <span class="fml-idle on-surface-subtle">Idle</span>
            </div>
        </div>

        <div class="fml-bottom">
            <div class="fml-controls-row">
                <div class="fml-transport">
                    <button class="fml-ctrl-btn fml-aux shuffle on-surface-subtle" title="Shuffle">{{icon "shuffle"}}</button>
                    <button class="fml-ctrl-btn back on-surface-muted" title="Previous">{{icon "skip-backward"}}</button>
                    <button class="fml-ctrl-btn fml-play play on-surface" title="Play / Pause">{{icon "play"}}</button>
                    <button class="fml-ctrl-btn forward on-surface-muted" title="Next">{{icon "skip-forward"}}</button>
                    <button class="fml-ctrl-btn fml-aux repeat on-surface-subtle" title="Repeat">{{icon "repeat"}}</button>
                </div>
            </div>
            <div class="fml-vol-row">
                <span class="accent-muted icon">{{icon "volume-low"}}</span>
                <input class="fml-vol-slider interactive-muted-bg interactive" type="range" min="0" max="1" step="0.02" value="0.5" />
                <span class="accent-muted icon">{{icon "volume-high"}}</span>
            </div>
        </div>

        {{if .Screen.Entity.ShowBrowser}}
        {{template "media-browser" .Screen.Entity}}
        {{end}}
    </div>
</div>
<script>
component(function(wrapper) {
    var entityId = '{{.Screen.Entity.EntityID}}';
    if (!entityId) { return; }

    var ctrl = makeMediaController(entityId{{if .Screen.Entity.Spotifyplus}}, { spotifyPlus: true }{{end}});

    var elBackdropArt  = wrapper.querySelector('.fml-backdrop-art');
    var elCoverWrap    = wrapper.querySelector('.fml-cover');
    var elCoverPH      = wrapper.querySelector('.fml-cover-placeholder');
    var elSongBlock    = wrapper.querySelector('.fml-song-block');
    var elSourceName   = wrapper.querySelector('.fml-source-name');
    var elPlay         = wrapper.querySelector('.fml-ctrl-btn.play');
    var elShuffle      = wrapper.querySelector('.fml-ctrl-btn.shuffle');
    var elRepeat       = wrapper.querySelector('.fml-ctrl-btn.repeat');
    var elVolSlider    = wrapper.querySelector('.fml-vol-slider');
    var elMediaBrowser = wrapper.querySelector('.mbrowser-container');

    // transport buttons
    wrapper.querySelector('.fml-ctrl-btn.back').addEventListener('click', function() {
        ctrl.prev();
    });
    wrapper.querySelector('.fml-ctrl-btn.forward').addEventListener('click', function() {
        ctrl.next();
    });
    elPlay.addEventListener('click', function() {
        ctrl.playPause();
    });
    elShuffle.addEventListener('click', function() {
        ctrl.toggleShuffle();
    });
    elRepeat.addEventListener('click', function() {
        ctrl.cycleRepeat();
    });
    if (elVolSlider) {
        elVolSlider.addEventListener('change', function() {
            ctrl.setVolume(parseFloat(elVolSlider.value));
        });
    }

    {{if .Screen.Entity.ShowBrowser}}
    var elBrowseBtn = wrapper.querySelector('.fml-browse-btn');
    if (elBrowseBtn) {
        elBrowseBtn.addEventListener('click', function() {
            elMediaBrowser.mediaBrowserOpen();
        });
    }
    {{end}}

    // play/pause state
    ctrl.onUpdate(null, function(state, _) {
        elPlay.innerHTML = (state === 'playing')
            ? '{{icon "pause"}}'
            : '{{icon "play"}}';
    });

    // song info + cover art
    ctrl.onUpdate(['media_title', 'media_artist', 'media_album_name'], function(state, attrs) {
        var title  = attrs.media_title   || '';
        var artist = attrs.media_artist  || '';
        var album  = attrs.media_album_name || '';

        if (!title && !artist) {
            elSongBlock.innerHTML = '<span class="fml-idle on-surface-subtle">Idle</span>';
            return;
        }
        var html = '';
        if (title)  { html += '<span class="fml-song-title on-surface">'  + title  + '</span>'; }
        if (artist) { html += '<span class="fml-song-artist on-surface-muted">' + artist + '</span>'; }
        {{if .Screen.Entity.ShowAlbum}}
        if (album)  { html += '<span class="fml-song-album on-surface-subtle">' + album  + '</span>'; }
        {{end}}
        elSongBlock.innerHTML = html;
    });

    // cover art + backdrop blur
    ctrl.onUpdate(['entity_picture'], function(state, attrs) {
        if (attrs.entity_picture) {
            var haBase = (function() {
                var cfgUrl = window.CONFIG && window.CONFIG.haUrl;
                if (cfgUrl) { return cfgUrl; }
                return window.location.origin.replace(/:\d+$/, ':8123');
            })();
            var src = haBase + attrs.entity_picture;

            // backdrop blur art
            elBackdropArt.src = src;
            elBackdropArt.className = 'fml-backdrop-art';
            elBackdropArt.onload = function() {
                elBackdropArt.className = 'fml-backdrop-art loaded';
            };

            // cover art in the card
            var img = elCoverWrap.querySelector('img');
            if (!img) {
                img = document.createElement('img');
                img.alt = '';
                elCoverWrap.insertBefore(img, elCoverWrap.firstChild);
            }
            img.src = src;
            elCoverPH.style.display = 'none';
        } else {
            elBackdropArt.src = '';
            elBackdropArt.className = 'fml-backdrop-art';
            var img = elCoverWrap.querySelector('img');
            if (img) { elCoverWrap.removeChild(img); }
            elCoverPH.style.display = '';
        }
    });

    // source / app name
    ctrl.onUpdate(['source'], function(state, attrs) {
        elSourceName.textContent = attrs.source || '–';
    });

    // volume
    ctrl.onUpdate(['volume_level', 'is_volume_muted'], function(state, attrs) {
        if (!elVolSlider) { return; }
        if (attrs.is_volume_muted) {
            elVolSlider.value = 0;
        } else if (typeof attrs.volume_level !== 'undefined') {
            elVolSlider.value = attrs.volume_level;
        }
    });

    // shuffle / repeat active state
    ctrl.onUpdate(['shuffle', 'repeat'], function(state, attrs) {
        if (attrs.shuffle) {
            elShuffle.className = elShuffle.className.replace(' fml-active', '') + ' fml-active accent';
        } else {
            elShuffle.className = elShuffle.className.replace(' fml-active accent', '') + ' on-surface-subtle';
        }
        var rep = attrs.repeat || 'off';
        if (rep !== 'off') {
            elRepeat.className = elRepeat.className.replace(' fml-active', '') + ' fml-active accent';
            elRepeat.innerHTML = (rep === 'one')
                ? '{{icon "repeat-once"}}'
                : '{{icon "repeat"}}';
        } else {
            elRepeat.className = elRepeat.className.replace(' fml-active accent', '') + ' on-surface-subtle';
            elRepeat.innerHTML = '{{icon "repeat"}}';
        }
    });
});
</script>
{{end}}