{{define "base-style"}}
<style>
    :root {
        font-size: 18px;
    }
    body {
        font-family: "Outfit", sans-serif;
        display: -webkit-flex;
        display: flex;
        -webkit-flex-direction: column;
        flex-direction: column;
        -webkit-justify-content: center;
        justify-content: center;
        -webkit-align-items: center;
        align-items: center;
        overflow: hidden;
    }

    html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
    }
        
    * {
        {{if enabledByDefault .Animations}}
        -webkit-transition: color 0.5s ease, background-color 0.5s ease, background 0.5s ease, opacity 0.4s ease, -webkit-transform 0.2s ease, fill 0.4s ease;
        transition: color 0.5s ease, background-color 0.5s ease, background 0.5s ease, opacity 0.4s ease, transform 0.2s ease, fill 0.4s ease;
        {{else}}
        -webkit-transition: none;
        transition: none;
        {{end}}
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        -webkit-tap-highlight-color: transparent;
    }
    
    button:focus { outline: none; }

    .card, .card-opaque {
        height: 100%;
        width: 100%;
    }
    .icon {
        height: 1em;
        width: 1em;
    }
</style>
{{end}}