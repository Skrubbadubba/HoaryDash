{{define "create-theme"}}
{{$p := .Prefix}}
<style>
{{/* Base layout */}}
{{$p}} {
    {{if .Size}}font-size: {{.Size}}em;{{end}}
{{with .Typography}}

        {{if .FontFamily}}font-family: {{.FontFamily | css}};{{end}}
        {{if .FontWeight}}font-weight: {{.FontWeight | css}};{{end}}
        {{if .FontStyle}}font-style: {{.FontStyle | css}};{{end}}
        {{if .TextTransform}}text-transform: {{.TextTransform | css}};{{end}}
        {{if .LetterSpacing}}letter-spacing: {{.LetterSpacing | css}};{{end}}
    }

    {{if .FontXXS}}  {{$p}} .font-xxs  { font-size:{{.FontXXS}}; }  {{end}}
    {{if .FontXS}}   {{$p}} .font-xs   { font-size:{{.FontXS}}; }   {{end}}
    {{if .FontSM}}   {{$p}} .font-sm   { font-size:{{.FontSM}}; }   {{end}}
    {{if .FontMD}}   {{$p}} .font-md   { font-size:{{.FontMD}}; }   {{end}}
    {{if .FontLG}}   {{$p}} .font-lg   { font-size:{{.FontLG}}; }   {{end}}
    {{if .FontXL}}   {{$p}} .font-xl   { font-size:{{.FontXL}}; }   {{end}}
    {{if .FontXXL}}  {{$p}} .font-xxl  { font-size:{{.FontXXL}}; }  {{end}}
    {{if .FontHero}} {{$p}} .font-hero { font-size:{{.FontHero}}; } {{end}}
{{end}}

{{/* Layered background */}}
{{if or .Background .BackgroundOverlay}}
{{$p}} {
    position: relative;
    z-index: 1;
}

{{$p}} > * {
    position: relative;
    z-index: 3; /* Ensure content is above overlays */
}

{{$p}}::before, {{$p}}::after {
    {{template "_pseudo"}}
}

{{if .Background}}
{{$p}}::before {
    z-index: 1;
    {{with .Background}}
        {{if .Color}}background-color: {{.Color | css}};{{end}}
        {{if .Image}}background-image: {{.Image | css}};{{end}}
        {{if .Size}}background-size: {{.Size | css}};{{end}}
        {{if .Position}}background-position: {{.Position | css}};{{end}}
        {{if .Repeat}}background-repeat: {{.Repeat | css}};{{end}}
        {{if .BlendMode}}-webkit-background-blend-mode: {{.BlendMode | css}}; background-blend-mode: {{.BlendMode | css}};{{end}}
        {{if .Filter}}-webkit-filter: {{.Filter | css}}; filter: {{.Filter | css}};{{end}}
        {{if .Opacity}}opacity: {{.Opacity}};{{end}}
    {{end}}
}
{{end}}

{{if .BackgroundOverlay}}
{{$p}}::after {
    z-index: 2;
    {{with .BackgroundOverlay}}
        {{if .Image}}background-image: {{.Image | css}};{{end}}
        {{if .Size}}background-size: {{.Size | css}};{{end}}
        {{if .Position}}background-position: {{.Position | css}};{{end}}
        {{if .Repeat}}background-repeat: {{.Repeat | css}};{{end}}
        {{if .BlendMode}}-webkit-background-blend-mode: {{.BlendMode | css}}; background-blend-mode: {{.BlendMode | css}};{{end}}
        {{if .Filter}}-webkit-filter: {{.Filter | css}}; filter: {{.Filter | css}};{{end}}
        {{if .Opacity}}opacity: {{.Opacity}};{{end}}
    {{end}}
}
{{end}}
{{end}}

{{/* --- SEMANTIC UTILITY CLASSES --- */}}
{{with .Colors}}
    {{if .Surface}}
    {{$p}} .surface { background-color: {{.Surface | css}}; }
    {{end}}

    {{if .SurfaceProminent}}
    {{$p}} .surface-prominent { background-color: {{.SurfaceProminent | css}}; }
    {{end}}

    {{if .SurfaceSubtle}}
    {{$p}} .surface-subtle { background-color: {{.SurfaceSubtle | css}}; }
    {{end}}

    {{if .SurfaceOpaque}}
    {{$p}} .surface-opaque { background-color: {{.SurfaceOpaque | css}}; }
    {{end}}

    {{if .SurfaceAlt}}
    {{$p}} .surface-alt { background-color: {{.SurfaceAlt | css}}; }
    {{end}}

    {{if .Highlight}}
    {{$p}} .highlight { background-color: {{.Highlight | css}}; }
    {{end}}

    {{if .Border}}
        {{$p}} .border { border-color: {{.Border}}; }
        {{$p}} .border-bg { background-color: {{.Border}}; }
    {{end}}

    {{/* Text + Icons */}}
    {{if .OnSurface}}
    {{$p}} .on-surface { color: {{.OnSurface | css}}; fill: {{.OnSurface | css}}; }
    {{end}}

    {{if .OnSurfaceMuted}}
    {{$p}} .on-surface-muted { color: {{.OnSurfaceMuted | css}}; fill: {{.OnSurfaceMuted | css}}; }
    {{end}}

    {{if .OnSurfaceSubtle}}
    {{$p}} .on-surface-subtle { color: {{.OnSurfaceSubtle | css}}; fill: {{.OnSurfaceSubtle | css}}; }
    {{$p}} input[type=text]::placeholder { {{.OnSurfaceSubtle | css}}; }
    {{end}}

    {{if .OnBackground}}
    {{$p}} .on-bg { color: {{.OnBackground | css}}; fill: {{.OnBackground | css}}; }
    {{end}}

    {{/* Accents */}}
    {{if .Accent}}
    {{$p}} .accent { color: {{.Accent | css}}; fill: {{.Accent | css}}; }
    {{$p}} .accent-bg { background-color: {{.Accent | css}}; }
    {{end}}

    {{if .AccentMuted}}
    {{$p}} .accent-muted { color: {{.AccentMuted | css}}; fill: {{.AccentMuted | css}}; }
    {{$p}} .accent-muted-bg { background-color: {{.AccentMuted | css}}; }
    {{end}}

    {{/* Interactive */}}
    {{if .Interactive}}
    {{$p}} .interactive { color: {{.Interactive | css}}; fill: {{.Interactive | css}}; }
    {{$p}} .interactive-bg { background-color: {{.Interactive | css}}; }
    {{$p}} input[type=range].interactive-thumb::-webkit-slider-thumb {
        background-color: {{.Interactive | css}};
    }
    {{$p}} input[type=range].interactive-thumb::-moz-range-thumb {
        background-color: {{.Interactive | css}};
    }
    {{end}}
    {{if .InteractiveMuted}}
    {{$p}} .interactive-muted { color: {{.InteractiveMuted | css}}; fill: {{.InteractiveMuted | css}}; }
    {{$p}} .interactive-muted-bg { background-color: {{.InteractiveMuted | css}}; }
    {{$p}} input[type=range].interactive-muted-thumb::-webkit-slider-thumb {
        background-color: {{.InteractiveMuted | css}};
    }
    {{$p}} input[type=range].interactive-muted-thumb::-moz-range-thumb {
        background-color: {{.InteractiveMuted | css}};
    }
    {{end}}
    {{if .InteractiveDisabled}}
    {{$p}} .interactive-disabled { color: {{.InteractiveDisabled | css}}; fill: {{.InteractiveDisabled | css}}; }
    {{$p}} .interactive-disabled-bg { background-color: {{.InteractiveDisabled | css}}; }
    {{$p}} input[type=range].interactive-disabled-thumb::-webkit-slider-thumb {
        opacity: 0;
    }
    {{$p}} input[type=range].interactive-disabled-thumb::-moz-range-thumb {
        opacity: 0;
    }
    {{end}}

    {{/* --- STATES & PILL BACKGROUNDS --- */}}

    {{/* The ::after is for the slider thumbs */}}
    {{if .StateOn}}
    {{$p}} .state.on, {{$p}} .on .state { color: {{.StateOn | css}}; fill: {{.StateOn | css}}; }
    {{$p}} .state-border.on, {{$p}} .on .state-border { border-color: {{.StateOn | css}}; }
    {{$p}} .state-bg.on::after, {{$p}} .on .state-bg::after { background-color: {{.StateOn | css}}; }
    {{end}}
    {{if .StateOff}}
    {{$p}} .state.off, {{$p}} .off .state { color: {{.StateOff | css}}; fill: {{.StateOff | css}}; }
    {{$p}} .state-border.off, {{$p}} .off .state-border { border-color: {{.StateOff | css}}; }
    {{$p}} .off.state-bg::after, {{$p}} .off .state-bg::after { background-color: {{.StateOff | css}}; }
    {{end}}
    {{if .StateDisabled}}
    {{$p}} .state.disabled, {{$p}} .disabled .state { color: {{.StateDisabled | css}}; fill: {{.StateDisabled | css}}; }
    {{$p}} .state-border.disabled, {{$p}} .disabled .state-border { border-color: {{.StateDisabled | css}}; }
    {{$p}} .disabled.state-bg::after, {{$p}} .disabled .state-bg::after { background-color: {{.StateDisabled | css}}; }
    {{end}}

    {{/* Semantic backgrounds also use the derived muted colors */}}
    {{if .Positive}}
    {{$p}} .positive { color: {{.Positive | css}}; fill: {{.Positive | css}}; }
    {{end}}


    {{if .Negative}}
    {{$p}} .negative { color: {{.Negative | css}}; fill: {{.Negative | css}}; }
    {{end}}

{{end}}


{{with .Derived}}
    {{/* The ::before is for the track */}}
    {{if .StateOnMuted}}
    {{$p}} .state-bg.on::before, {{$p}} .on .state-bg::before { background-color: {{.StateOnMuted | css}}; {{template "_pseudo"}} }
    {{end}}
    {{if .StateOffMuted}}
    {{$p}} .off.state-bg::before, {{$p}} .off .state-bg::before { background-color: {{.StateOffMuted | css}}; {{template "_pseudo"}} }
    {{end}}
    {{if .StateDisabledMuted}}
    {{$p}} .disabled.state-bg::before, {{$p}} .disabled .state-bg::before { background-color: {{.StateDisabledMuted | css}}; {{template "_pseudo"}} }
    {{end}}
    {{if .PositiveMuted}}
    {{$p}} .positive-bg { background-color: {{.PositiveMuted | css}}; }
    {{end}}
    {{if .NegativeMuted}}
    {{$p}} .negative-bg { background-color: {{.NegativeMuted | css}}; }
    {{end}}
{{end}}




{{/* Geometry */}}
{{with .Shapes}}
    {{if .PaddingInner}}
        {{$p}} .padding.inner { padding: {{.PaddingInner}}; }
    {{end}}
    {{if .GapOuter}}
        {{$p}} .gap-outer > * + *,
        {{$p}} .gap-outer.gap-from-first > * { margin: {{.GapOuter}}; }
    {{end}}
    {{if .GapInner}}
        {{$p}} .gap-inner > * + *,
        {{$p}} .gap-inner.gap-from-first > * { margin: {{.GapInner}}; }
    {{end}}
    {{if .WideBorderRadius}}
        {{$p}} .border-wide { border-radius: {{.WideBorderRadius}}; }
    {{end}}
    {{if .MediumBorderRadius}}
        {{$p}} .border-medium { border-radius: {{.MediumBorderRadius}}; }
    {{end}}
    {{if .TightBorderRadius}}
        {{$p}} .border-tight { border-radius: {{.TightBorderRadius}}; }
    {{end}}
    {{if .BorderThin}}
        {{$p}} .border-thin { border-width: {{.BorderThin}}; }
        {{$p}} .divider-thin { height: {{.BorderThin}}; width: {{.BorderThin}}; }
    {{end}}
    {{if .BorderThick}}
        {{$p}} .border-thick { border-width: {{.BorderThick}}; }
        {{$p}} .divider-thick { height: {{.BorderThick}}; width: {{.BorderThick}}; }
    {{end}}

    {{if .Borders}}
    {{$p}} .border {
        border-style: {{if .Borders | bool}}solid{{else}}none{{end}};
    }
    {{end}}
{{end}}

{{/* --- CARD-LIKE DEFAULT ASSIGNMENTS --- */}}
{{/* Colors and geometry assigned from semantic theme values.              */}}
{{/* CardStyle override blocks below take precedence via specificity.      */}}

{{if or .Colors.Surface .Shapes.MediumBorderRadius .Shapes.BorderThick}}
{{$p}} .card {
    {{if .Colors.Surface}}background-color: {{.Colors.Surface | css}};{{end}}
    {{if .Shapes.MediumBorderRadius}}border-radius: {{.Shapes.MediumBorderRadius | css}};{{end}}
    {{if .Shapes.BorderThick}}border-width: {{.Shapes.BorderThick | css}};{{end}}
}
{{end}}

{{if or .Colors.SurfaceOpaque .Shapes.MediumBorderRadius .Shapes.BorderThick}}
{{$p}} .modal {
    {{if .Colors.SurfaceOpaque}}background-color: {{.Colors.SurfaceOpaque | css}};{{end}}
    {{if .Shapes.MediumBorderRadius}}border-radius: {{.Shapes.MediumBorderRadius | css}};{{end}}
    {{if .Shapes.BorderThick}}border-width: {{.Shapes.BorderThick | css}};{{end}}
}
{{end}}

{{if or .Colors.SurfaceSubtle .Shapes.WideBorderRadius .Shapes.BorderThin}}
{{$p}} .badge {
    {{if .Colors.SurfaceSubtle}}background-color: {{.Colors.SurfaceSubtle | css}};{{end}}
    {{if .Shapes.WideBorderRadius}}border-radius: {{.Shapes.WideBorderRadius | css}};{{end}}
    {{if .Shapes.BorderThin}}border-width: {{.Shapes.BorderThin | css}};{{end}}
}
{{$p}} .badge-btn {
    {{if .Colors.SurfaceSubtle}}background-color: {{.Colors.SurfaceSubtle | css}};{{end}}
    {{if .Shapes.TightBorderRadius}}border-radius: {{.Shapes.TightBorderRadius | css}};{{end}}
    {{if .Shapes.BorderThin}}border-width: {{.Shapes.BorderThin | css}};{{end}}
}
{{end}}

{{if or .Colors.SurfaceProminent .Shapes.MediumBorderRadius}}
{{$p}} .button {
    {{if .Colors.SurfaceProminent}}background-color: {{.Colors.SurfaceProminent | css}};{{end}}
    {{if .Shapes.MediumBorderRadius}}border-radius: {{.Shapes.MediumBorderRadius | css}};{{end}}
}
{{end}}

{{if or .Colors.Surface .Shapes.MediumBorderRadius .Shapes.BorderThick}}
{{$p}} .tooltip {
    {{if .Colors.SurfaceOpaque}}background-color: {{.Colors.SurfaceOpaque | css}};{{end}}
    {{if .Shapes.MediumBorderRadius}}border-radius: {{.Shapes.MediumBorderRadius | css}};{{end}}
    {{if .Shapes.BorderThick}}border-width: {{.Shapes.BorderThick | css}};{{end}}
}
{{end}}

{{/* --- STRUCTURAL CARD OVERRIDES --- */}}
{{if .Cards}}
{{$p}} .card {
    {{template "create-card-theme" .Cards}}
}
{{end}}
{{if .Entities}}
{{$p}} .entity.card {
    {{template "create-card-theme" .Entities}}
}
{{end}}

{{if .Sensors}}
{{$p}} .sensor.card {
    {{template "create-card-theme" .Sensors}}
}
{{end}}

{{if .Widgets}}
{{$p}} .widget.card {
    {{template "create-card-theme" .Widgets}}
}
{{end}}
{{if .Badges}}
{{$p}} .badge {
    {{template "create-card-theme" .Badges}}
}
{{end}}
{{if .BadgeButtons}}
{{$p}} .badge-btn {
    {{template "create-card-theme" .BadgeButtons}}
}
{{end}}
{{if .Tooltips}}
{{$p}} .tooltip {
    {{template "create-card-theme" .Tooltips}}
}
{{end}}
{{if .Modals}}
{{$p}} .modal.card {
    {{template "create-card-theme" .Modals}}
}
{{end}}

{{if .Buttons}}
{{$p}} .button {
    {{template "create-card-theme" .Buttons}}
}
{{end}}

{{if .Custom}}
    {{resolveThis .Custom $p | css}}
{{end}}

</style>
{{end}}