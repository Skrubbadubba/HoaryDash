{{define "_before"}}
    content: '';
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    z-index: -1;
    top: 0;
    right: 0;
{{end}}
{{define "create-theme"}}
{{$p := .Prefix}}
<style>

{{/* Base layout */}}
{{if or .FontSize .Background}}
{{$p}} {
    {{if .FontSize}}font-size: {{.FontSize}}px;{{end}}
    {{if .Background}}background: {{.Background | css}};{{end}}
}
{{end}}

{{/* Semantic utility classes */}}
{{if .Surface}}
{{$p}} .surface {
    background-color: {{.Surface | css}};
}
{{end}}

{{if .SurfaceProminent}}
{{$p}} .surface-prominent {
    background-color: {{.SurfaceProminent | css}};
}
{{else if .Surface}}
{{$p}} .surface-prominent {
    background-color: {{.Surface | css}};
}
{{end}}

{{if .SurfaceOpaque}}
{{$p}} .surface-opaque {
    background-color: {{.SurfaceOpaque}};
}
{{end}}

{{if .SurfaceAlt}}
{{$p}} .surface-alt {
    background-color: {{.SurfaceAlt}};
}
{{end}}

{{if .Highlight}}
{{$p}} .highlight {
    background-color: {{.Highlight}};
}
{{end}}

{{if .OnSurface}}
{{$p}} .on-surface {
    color: {{.OnSurface | css}};
    fill: {{.OnSurface | css}};
}
{{end}}

{{if .OnSurfaceMuted}}
{{$p}} .on-surface-muted {
    color: {{.OnSurfaceMuted | css}};
    fill: {{.OnSurfaceMuted | css}};
}
{{else if .OnSurface}}
{{$p}} .on-surface-muted {
    color: {{.OnSurface | css}};
    fill: {{.OnSurface | css}};
    opacity: 0.6;
}
{{end}}

{{if .OnSurfaceSubtle}}
{{$p}} .on-surface-subtle {
    color: {{.OnSurfaceSubtle | css}};
    fill: {{.OnSurfaceSubtle | css}};
}
{{else if .OnSurface}}
{{$p}} .on-surface-subtle {
    color: {{.OnSurface | css}};
    fill: {{.OnSurface | css}};
    opacity: 0.35;
}
{{end}}

{{if .OnBackground}}
{{$p}} .on-bg {
    color: {{.OnBackground | css}};
    fill: {{.OnBackground | css}};
}
{{else if .OnSurface}}
{{$p}} .on-bg {
    color: {{.OnSurface | css}};
    fill: {{.OnSurface | css}};
}
{{end}}

{{if .Accent}}
{{$p}} .accent {
    color: {{.Accent | css}};
    fill: {{.Accent | css}};
}
{{$p}} .accent-bg {
    background-color: {{.Accent | css}};
}
{{end}}

{{if .AccentMuted}}
{{$p}} .accent-muted {
    color: {{.AccentMuted | css}};
    fill: {{.AccentMuted | css}};
}
{{$p}} .accent-muted-bg {
    background-color: {{.AccentMuted | css}};
}
{{else if .Accent}}
{{$p}} .accent-muted {
    color: {{.Accent | css}};
    fill: {{.Accent | css}};
    opacity: 0.5;
}
{{$p}} .accent-muted-bg {
    position: relative;
    z-index: 0;
}
{{$p}} .accent-muted-bg::before {
    {{template "_before"}}
    background-color: {{.Accent}};
    opacity: 0.5;
}
{{end}}

{{if .Interactive}}
{{$p}} .interactive {
    color: {{.Interactive | css}};
    fill: {{.Interactive | css}};
}
{{$p}} .interactive-bg {
    background-color: {{.Interactive | css}};
}
{{$p}} input[type=range].interactive::-webkit-slider-thumb,
{{$p}} input[type=range].interactive::-moz-range-thumb {
    background-color: {{.Interactive | css}};
}
{{end}}

{{if .InteractiveMuted}}
{{$p}} .interactive-muted {
    color: {{.InteractiveMuted | css}};
    fill: {{.InteractiveMuted | css}};
}
{{$p}} input[type=range].interactive-muted::-webkit-slider-thumb,
{{$p}} input[type=range].interactive-muted::-moz-range-thumb {
    background-color: {{.InteractiveMuted | css}};
}
{{$p}} .interactive-muted-bg {
    background-color: {{.InteractiveMuted | css}};
}
{{else if .Interactive}}
{{$p}} .interactive-muted {
    color: {{.Interactive | css}};
    fill: {{.Interactive | css}};
    opacity: 0.6;
}
{{$p}} input[type=range].interactive-muted::-webkit-slider-thumb,
{{$p}} input[type=range].interactive-muted::-moz-range-thumb {
    background-color: {{.Interactive | css}};
}
{{$p}} .interactive-muted-bg {
    position: relative;
    z-index:0;
}
{{$p}} .interactive-muted-bg::before {
    background-color: {{.Interactive | css}};
    opacity: 0.6;
    {{template "_before"}}
}
{{end}}

{{$p}} input[type=range].interactive-disabled::-webkit-slider-thumb,
{{$p}} input[type=range].interactive-disabled::-moz-range-thumb {
    opacity: 0;
}
{{if .InteractiveDisabled}}
{{$p}} .interactive-disabled {
    color: {{.InteractiveDisabled | css}};
    fill: {{.InteractiveDisabled | css}};
}
{{$p}} .interactive-disabled-bg {
    background-color: {{.InteractiveDisabled | css}};
}
{{else if .Interactive}}
{{$p}} .interactive-disabled {
    color: {{.Interactive | css}};
    fill: {{.Interactive | css}};
    opacity: 0.5;
}
{{$p}} .interactive-disabled-bg {
    position: relative;
    z-index:0;
}
{{$p}} .interactive-disabled-bg::before {
    background-color: {{.Interactive | css}};
    opacity: 0.5;
    {{template "_before"}}
}
{{end}}

{{if or .StateOff .StateOn .StateDisabled}}
{{$p}} .state-bg {
    z-index: 0;
    position: relative;
}
{{$p}} .state-bg::before {
    {{template "_before"}}
    opacity: 0.35;
}
{{end}}
{{if .StateOn}}
{{$p}} .state.on, {{$p}} .on .state {
    color: {{.StateOn | css}};
    fill: {{.StateOn | css}};
}
{{$p}} .state-bg.on::before, {{$p}} .on .state-bg::before {
    background-color: {{.StateOn | css}};
}
{{$p}} .state-bg.on::after, {{$p}} .on .state-bg::after {
    background-color: {{.StateOn | css}};
}
{{$p}} .state-border.on, {{$p}} .on .state-border {
    border-color: {{.StateOn | css}};
}
{{end}}

{{if .StateOff}}
{{$p}} .state.off, {{$p}} .off .state {
    color: {{.StateOff | css}};
    fill: {{.StateOff | css}};
}
{{$p}} .off.state-bg::before, {{$p}} .off .state-bg::before {
    background-color: {{.StateOff | css}};
}
{{$p}} .off.state-bg::after, {{$p}} .off .state-bg::after {
    background-color: {{.StateOff | css}};
}
{{$p}} .state-border.off, {{$p}} .off .state-border {
    border-color: {{.StateOff | css}};
}
{{end}}

{{if .StateDisabled}}
{{$p}} .state.disabled, {{$p}} .disabled .state {
    color: {{.StateDisabled | css}};
    fill: {{.StateDisabled | css}};
}
{{$p}} .disabled.state-bg::before, {{$p}} .disabled .state-bg::before {
    background-color: {{.StateDisabled | css}};
}
{{$p}} .disabled.state-bg::after, {{$p}} .disabled .state-bg::after {
    background-color: {{.StateDisabled | css}};
}
{{$p}} .state-border.disabled, {{$p}} .disabled .state-border {
    border-color: {{.StateDisabled | css}};
}
{{end}}

{{if .Positive}}
{{$p}} .positive {
    color: {{.Positive | css}};
    fill: {{.Positive | css}};
}
{{$p}} .positive-bg {
    position: relative;
}
{{$p}} .positive-bg::before {
    background-color: {{.Positive | css}};
    opacity: 0.5;
    {{template "_before"}}
}
{{end}}

{{if .Negative}}
{{$p}} .negative {
    color: {{.Negative | css}};
    fill: {{.Negative | css}};
}
{{$p}} .negative-bg {
    position: relative;
}
{{$p}} .negative-bg::before {
    background-color: {{.Negative | css}};
    opacity: 0.5;
    {{template "_before"}}
}
{{end}}

{{/* Structural card overrides — only emitted when fields are present */}}
{{if .Cards}}
{{$p}} .card, {{$p}} .card-opaque {
    {{template "create-card-theme" .Cards}}
}
{{$p}} .card-opaque {
    background-color: {{.SurfaceOpaque | css}};
}
{{else}}
{{$p}} .card {
    background-color: {{.Surface | css}};
}
{{$p}} .card-opaque {
    background-color: {{.SurfaceOpaque | css}};
}
{{$p}} .card, {{$p}} .card-opaque {
    border-color: {{.Border | css}}
}
{{end}}

{{if .Entities}}
{{$p}} .entity.card {
    {{template "create-card-theme" .Entities}}
}
{{end}}

{{if .Sensors}}
{{$p}} .sensor.card {
    {{template "create-card-theme" .Sensors}}
}
{{end}}

{{if .Widgets}}
{{$p}} .widget.card {
    {{template "create-card-theme" .Widgets}}
}
{{end}}

{{if .Modal}}
{{$p}} .modal {
    {{template "create-card-theme" .Modal}}
}
{{else if .OpaqueBackground}}
{{$p}} .modal {
    background-color: {{.OpaqueBackground}}
}
{{end}}
</style>
{{end}}