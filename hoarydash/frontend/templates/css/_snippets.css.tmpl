{{define "_transition"}}
    {{if globals "Animations"}}
    -webkit-transition: color 0.5s ease, background-color 0.5s ease, background 0.5s ease, opacity 0.4s ease, -webkit-transform 0.3s ease, fill 0.4s ease;
    transition: color 0.5s ease, background-color 0.5s ease, background 0.5s ease, opacity 0.4s ease, transform 0.3s ease, fill 0.4s ease;
    {{else}}
    -webkit-transition: none;
    transition: none;
    {{end}}
{{end}}

{{define "_transition-fast"}}
    {{if globals "Animations"}}
    -webkit-transition: color 0.3s ease, background-color 0.2s ease, background 0.2s ease, opacity 0.2s ease, -webkit-transform 0.18s ease, fill 0.2s ease;
    transition: color 0.3s ease, background-color 0.2s ease, background 0.2s ease, opacity 0.2s ease, transform 0.18s ease, fill 0.2s ease;
    {{else}}
    -webkit-transition: none;
    transition: none;
    {{end}}
{{end}}

{{define "_slider-thumb"}}
    -webkit-appearance: none;
    display: flex;
    {{template "_flex-grow-1"}}
    flex-shrink: 0;
    border: none;
    outline: none;
    cursor: pointer;
{{end}}

{{define "_pseudo"}}
    content: '';
    position: absolute;
    {{template "_size-full"}}
    border-radius: inherit;
    z-index: -1;
    top: 0;
    right: 0;
    pointer-events: none;
{{end}}

{{define "_flex"}}
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
{{end}}

{{define "_flex-row"}}
    -webkit-box-orient: horizontal;
    -webkit-flex-direction: row;
    flex-direction: row;
{{end}}

{{define "_flex-col"}}
    -webkit-box-orient: vertical;
    -webkit-flex-direction: column;
    flex-direction: column;
{{end}}

{{define "_align-center"}}
    -webkit-box-align: center;
    -webkit-align-items: center;
    align-items: center;
{{end}}

{{define "_flex-grow-1"}}
    -webkit-box-flex: 1;
    -webkit-flex: 1;
    flex: 1;
{{end}}

{{define "_flex-grow-0"}}
    -webkit-box-flex: 0;
    -webkit-flex: 0;
    flex: 0;
{{end}}

{{define "_size-full"}}
    width: 100%;
    height: 100%;
{{end}}