{{define "_toggle-style"}}
<style>
  .ha-toggle {
    min-width: 80px;
    cursor: pointer;
    overflow: clip;
  }

  .ha-toggle-body {
    height: max-content;
    margin: auto;
  }

  .ha-toggle-icon {
    margin-right: -0.2em !important;
    line-height: 1;
  }

  .ha-toggle.off .ha-toggle-icon {
    opacity: 0.38;
  }

  .ha-toggle-label {
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.6)
  }

  .ha-toggle-pill {
    width: 1.25em;
    height: 2.25em;
    border-radius: 0.625em;
    border: 1px solid;
    position: relative;
    pointer-events: none;
  }
  
  .ha-toggle-pill::after {
    content: '';
    position: absolute;
    top: 1.1875em;
    left: 0.2em;
    width: 0.75em;
    height: 0.75em;
    border-radius: 50%;
  }

  .ha-toggle.on .ha-toggle-pill::after {
    transform: translateY(-1em);
  }
</style>
{{end}}
{{define "_toggle-open"}}
<div class="ha-toggle card entity border off card-wrapper flex flex-col">
  <button class="ha-toggle-btn card entity transition-fast btn card-inner flex flex-col align-start justify-start size-full" title="{{.Label}}">
    <div class="ha-toggle-body flex-line gap-inner gap-x">
      {{if or .Icon .Label}}
      <div class="ha-toggle-left flex-line gap-inner gap-x">
        {{if .Icon}}
        <div class="ha-toggle-icon interactive font-xl">
          {{if isEmoji .Icon}}
              {{.Icon}}
          {{else}}
              {{icon .Icon}}
          {{end}}
        </div>
        {{end}}
        <div class="ha-toggle-label text-ellipsis entity-label on-surface">{{.Label}}</div>
      </div>
      {{end}}
      <div class="ha-toggle-pill flex-shrink-0 state-bg state-border"></div>
    </div>
    <div class="flex-grow"></div>
  </button>
{{end}}
{{define "_toggle-script"}}
<script>
component(function(btn) {
  var entityId = '{{.EntityID}}';
  var domain = entityId.split('.')[0];
  var wrapper = btn.parentElement;

  function setState(state) {
    if (state === 'on') {
      wrapper.classList.remove('off');
      wrapper.classList.add('on');
    } else if (state === 'off') {
      wrapper.classList.remove('on');
      wrapper.classList.add('off');
    }
  }

  window.entityListeners[entityId].push(function(state, attributes) {
    setState(state);
  });

  btn.addEventListener('click', function() {
    window.haSend({
      type: 'call_service',
      domain: domain,
      service: 'toggle',
      target: { entity_id: entityId }
    });
  });
});
</script>
{{end}}
{{define "toggle"}}
  {{if once "toggle-style"}}
    {{template "_toggle-style"}}
  {{end}}
{{template "_toggle-open" .}}
{{template "_toggle-script" .}}
</div>
{{end}}